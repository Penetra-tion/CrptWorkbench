{
  "Crpt": {
    // Mock — все интеграции локальные, даже при реальных адресах ниже и в профиле.
    // Production — реальные True API, НК и статус документа СУЗ. После смены нужен перезапуск.
    // Статус заказа СУЗ (Mock) остаётся локальной демонстрацией в обоих режимах.
    // Переменные окружения (Crpt__Mode), appsettings.<окружение>.json и аргументы запуска
    // могут переопределять этот файл. Установщик службы больше не задаёт Crpt__Mode.
    "Mode": "Mock",
    // Разрешённые production-адреса; в Mock не используются для сетевых вызовов.
    "TrueApiBaseUrl": "https://markirovka.crpt.ru/api/v3/true-api",
    "NationalCatalogBaseUrl": "https://апи.национальный-каталог.рф",
    // Совместимость со старым конфигом: текущая подпись использует CryptoAPI/CSP, не этот EXE.
    "CryptoProExecutablePath": "C:\\Program Files\\Crypto Pro\\CSP\\csptest.exe",
    // Для Production поддерживается только My (Личное) в LocalMachine (компьютер).
    "CertificateStoreName": "My",
    "CertificateStoreLocation": "LocalMachine",
    // Устаревший таймаут в секундах: текущий вызов CryptoAPI этим значением не ограничивается.
    "CryptoProTimeoutSeconds": 30,
    // Срок хранения токена в памяти, в часах: целое число от 1 до 9.
    "TokenCacheHours": 9,
    // Абсолютный путь к БД, ключам и относительным логам. Пусто: Mock — App_Data рядом
    // с приложением, Production — ProgramData/CrptWorkbench. Служба задаёт путь через окружение.
    "DataDirectory": ""
  },
  // Допустимые HTTP Host-заголовки: * — любые; список имён через ;. Это не адрес прослушивания.
  "AllowedHosts": "*",
  "Serilog": {
    // false — безопасный сокращённый журнал; true — подробные события для диагностики.
    // Маскирование известных секретов не гарантирует очистку произвольных сообщений
    // библиотек/криптопровайдера. Включайте временно; проверяйте логи перед передачей.
    "FullLoggingEnabled": false,
    // Сборки обработчиков журналирования; имена должны соответствовать установленным пакетам.
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Expressions"
    ],
    // Пороги каналов: Verbose, Debug, Information, Warning, Error, Fatal.
    // $client — интерфейс/Blazor; $server — сервер и интеграции. Уровни меняются без перезапуска.
    "LevelSwitches": {
      "$client": "Information",
      "$server": "Information"
    },
    // Общий входной порог и переопределения по категориям; затем применяются пороги каналов.
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    // Два независимых файловых канала. Фильтры разделяют UI и сервер без дублирования.
    "WriteTo": [
      {
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Args": {
                  "expression": "not (StartsWith(SourceContext, 'CrptWorkbench.Web.Components.') or SourceContext = 'CrptWorkbench.Web.ClientDiagnostics' or StartsWith(SourceContext, 'Microsoft.AspNetCore.Components.Server.Circuits.'))"
                },
                "Name": "ByIncludingOnly"
              }
            ],
            "WriteTo": [
              {
                "Args": {
                  "levelSwitch": "$server",
                  // Лимит файла в байтах (20 МиБ); при достижении создаётся следующий файл.
                  "fileSizeLimitBytes": 20971520,
                  "rollOnFileSizeLimit": true,
                  // Формат строки Serilog: время, уровень, категория, корреляция, сообщение, ошибка.
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {CorrelationId} {Message:lj}{NewLine}{Exception}",
                  // Хранить до 31 файла (не дней); дополнительно создавать новый файл ежедневно.
                  "retainedFileCountLimit": 31,
                  "rollingInterval": "Day",
                  // Относительный путь считается от Crpt:DataDirectory, а не от каталога EXE.
                  "path": "logs/server/server-.log"
                },
                "Name": "File"
              }
            ],
            "MinimumLevel": "Verbose"
          }
        },
        "Name": "Logger"
      },
      {
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Args": {
                  "expression": "StartsWith(SourceContext, 'CrptWorkbench.Web.Components.') or SourceContext = 'CrptWorkbench.Web.ClientDiagnostics' or StartsWith(SourceContext, 'Microsoft.AspNetCore.Components.Server.Circuits.')"
                },
                "Name": "ByIncludingOnly"
              }
            ],
            "WriteTo": [
              {
                "Args": {
                  "levelSwitch": "$client",
                  // Те же единицы и правила ротации; отдельные файлы событий интерфейса.
                  "fileSizeLimitBytes": 20971520,
                  "rollOnFileSizeLimit": true,
                  "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {CorrelationId} {Message:lj}{NewLine}{Exception}",
                  "retainedFileCountLimit": 31,
                  "rollingInterval": "Day",
                  "path": "logs/client/client-.log"
                },
                "Name": "File"
              }
            ],
            "MinimumLevel": "Verbose"
          }
        },
        "Name": "Logger"
      }
    ]
  }
}
