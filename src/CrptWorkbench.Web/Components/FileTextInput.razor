@implements IAsyncDisposable
@inject IJSRuntime JavaScript

<div id="@ZoneId" class="file-text-input @(Disabled ? "is-disabled" : null)">
    @ChildContent
    @if (Hint is not null) { <span class="file-text-hint">@Hint</span> }
    <button id="@(FileId + "-attach")" type="button" class="file-text-attach" title="Выбрать TXT-файл" aria-label="Выбрать TXT-файл" disabled="@Disabled">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m20.5 11.5-8.7 8.7a5 5 0 0 1-7.1-7.1l9.2-9.2a3.5 3.5 0 0 1 5 5l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.6-8.6" /></svg>
    </button>
    <InputFile id="@FileId" OnChange="HandleFileAsync" accept=".txt,text/plain" disabled="@Disabled" tabindex="-1" aria-hidden="true" />
</div>
@if (_error is not null) { <p class="error-text" role="alert">@_error</p> }

@code {
    [Parameter, EditorRequired] public string ZoneId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string FileId { get; set; } = string.Empty;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnFileChange { get; set; }
    private IJSObjectReference? _module;
    private DotNetObjectReference<FileTextInput>? _reference;
    private long _attachmentToken;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/file-text-input.js");
        _reference = DotNetObjectReference.Create(this);
        _attachmentToken = await _module.InvokeAsync<long>("attach", ZoneId, FileId, FileId + "-attach", _reference);
    }

    private async Task HandleFileAsync(InputFileChangeEventArgs args)
    {
        if (Disabled) return;
        if (args.FileCount != 1) { await MultipleFiles(); return; }
        _error = null;
        await OnFileChange.InvokeAsync(args);
    }

    [JSInvokable] public Task MultipleFiles() => InvokeAsync(() =>
    {
        _error = "Выберите только один TXT-файл.";
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("detach", ZoneId, _attachmentToken); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _reference?.Dispose();
    }
}
