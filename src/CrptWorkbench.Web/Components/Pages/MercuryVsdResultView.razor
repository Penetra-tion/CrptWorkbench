@using CrptWorkbench.Application

<div class="mercury-vsd-result">
<div class="friendly-result-head"><div class="result-icon" aria-hidden="true">✓</div><div><span class="eyebrow">Меркурий</span><h2>Сведения о ВСД</h2></div></div>
<div class="permit-status @StatusTone(Result.Status)" role="status"><span>Статус</span><strong>@(string.IsNullOrWhiteSpace(Result.Status) ? "Не указан" : Result.Status)</strong></div>
<div class="permit-fields">
    @Field("УИД", Result.Uid)
    @Field("Дата оформления", Result.IssueDate)
    @if (Result.BatchNumbers.Count > 0) { <article class="permit-field permit-field-wide"><span>Номер производственной партии</span><IncrementalList Items="@Result.BatchNumbers" ResetKey="@Result" Context="batch"><ChildContent><strong>@batch</strong></ChildContent></IncrementalList></article> }
    @Field("GTIN", Result.Gtin)
    @Field("Название продукции", Result.ProductName, true)
    @Field("Объём", Result.Volume)
    @Field("Годен до", Result.Expiry)
    @if (Result.Packages.Count > 0) { <article class="permit-field permit-field-wide"><span>Упаковка</span><IncrementalList Items="@Result.Packages" ResetKey="@Result" Context="package"><ChildContent><strong>@package</strong></ChildContent></IncrementalList></article> }
</div>
</div>

@code {
    [Parameter, EditorRequired] public MercuryVsdInfoResult Result { get; set; } = default!;
    private static string StatusTone(string? status) => status?.Trim().ToLowerInvariant() switch
    {
        "оформлен" => "tone-success",
        "погашен" => "tone-warning",
        "аннулирован" => "tone-error",
        _ => "tone-neutral"
    };

    private RenderFragment Field(string label, string? value, bool wide = false) => builder =>
    {
        if (string.IsNullOrWhiteSpace(value)) return;
        builder.OpenElement(0, "article"); builder.AddAttribute(1, "class", wide ? "permit-field permit-field-wide" : "permit-field");
        builder.OpenElement(2, "span"); builder.AddContent(3, label); builder.CloseElement();
        builder.OpenElement(4, "strong"); builder.AddContent(5, value); builder.CloseElement();
        builder.CloseElement();
    };
}

