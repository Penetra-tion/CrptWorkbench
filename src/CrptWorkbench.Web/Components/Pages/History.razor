@page "/history"
@using System.Text.Json
@using Microsoft.AspNetCore.WebUtilities
@inject HistoryService HistoryService
@inject WorkbenchContext Workbench
@inject IApiOperationRegistry Registry
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>История — CRPT Workbench</PageTitle>

<div class="page-heading"><div><span class="eyebrow">Диагностика</span><h1>История запросов</h1></div><button class="button ghost" @onclick="LoadAsync">Обновить</button></div>

<div class="history-grid @(_items.Count == 0 && !_missing ? "history-empty" : null)">
    <section class="panel history-list">
        @if (_items.Count == 0) { <div class="empty">История выбранного профиля пуста.</div> }
        else
        {
            <table><thead><tr><th>Время</th><th>Система</th><th>Операция</th><th>Статус</th><th>мс</th></tr></thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr class="request-row @(_selected?.Id == item.Id ? "selected" : null)" role="link" tabindex="0" aria-label="@($"Открыть запрос: {OperationName(item.OperationId)}")" aria-current="@(_selected?.Id == item.Id ? "true" : null)" @onclick="() => OpenHistory(item.Id)" @onkeydown="args => OnRowKeyDown(args, item.Id)"><td>@item.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm:ss")</td><td>@SystemName(item.System)</td><td><a class="history-operation-link" href="@($"/history?id={item.Id}")" tabindex="-1" @onclick:stopPropagation="true">@OperationName(item.OperationId)</a></td><td><span class="status @(item.Success ? "ok" : "fail")">@(item.StatusCode?.ToString() ?? "ERR")</span></td><td>@item.DurationMs</td></tr>
                }
            </tbody></table>
        }
    </section>

    @if (_items.Count > 0 || _missing)
    {
    <section class="panel detail">
        @if (_missing) { <div class="notice error" role="alert">Запись не найдена в выбранном профиле. Выберите другой запрос в списке.</div> }
        else if (_selected is null) { <div class="empty">Выберите запрос в списке.</div> }
        else
        {
            <div @key="_selected.Id" class="history-result-enter">
            <h2>@OperationName(_selected.OperationId)</h2>
            <div class="metrics"><span>@SystemName(_selected.System)</span><span>@(_selected.StatusCode?.ToString() ?? "ERR")</span><span>@_selected.DurationMs мс</span></div>
            <div class="result-view-switch view-switch" role="group" aria-label="Представление результата">
                <button type="button" class="@(!_technicalMode ? "active" : null)" aria-pressed="@(!_technicalMode)" @onclick="() => _technicalMode = false">◫ Обычный</button>
                <button type="button" class="@(_technicalMode ? "active" : null)" aria-pressed="@_technicalMode" @onclick="() => _technicalMode = true">{ } Технический</button>
            </div>
            @if (!_technicalMode)
            {
                @if (_result?.Codes is not null)
                {
                    @if (_selected.OperationId == TrueApiBulkCodeInfoHandler.OperationId && _result.Codes.Items.Count > 50)
                    {
                        <p class="muted">Показаны первые 50 из @_result.Codes.Items.Count результатов. Полный ответ доступен в техническом виде.</p>
                    }
                    <CodeInfoResultView Results="@(_selected.OperationId == TrueApiBulkCodeInfoHandler.OperationId ? new CodeInfoResults(_result.Codes.Items.Take(50).ToArray()) : _result.Codes)" OnCodeSelected="RequestRelatedCode" OnGtinSelected="RequestGtin" OnDocumentSelected="RequestDocument" ShowOwnCodeAction="@(_selected.OperationId == TrueApiBulkCodeInfoHandler.OperationId)" />
                }
                else if (_result?.Product is not null) { <NationalCatalogProductResultView Result="_result.Product" /> }
                else if (_result?.Documents is not null) { <DocumentStatusResultView Results="_result.Documents" /> }
                else if (_result?.SuzDocuments is not null) { <SuzDocumentStatusResultView Results="_result.SuzDocuments" /> }
                else if (_result?.MercuryVsd is not null) { <MercuryVsdResultView Result="_result.MercuryVsd" /> }
                else if (_result?.PermitDocument is not null) { <PermitDocumentResultView Result="_result.PermitDocument" /> }
                else if (_result?.Fields.Count > 0)
                {
                    <div class="result-grid">
                        @foreach (var field in _result.Fields)
                        {
                            <article class="result-field"><span>@field.Label</span><strong>@field.Value</strong></article>
                        }
                    </div>
                }
                else { <div class="notice error" role="alert">@_result?.Notice</div> }
            }
            else
            {
                <div class="muted">Идентификатор операции: @_selected.OperationId</div>
                @if (!string.IsNullOrEmpty(_selected.Error)) { <div class="notice error">@_selected.Error</div> }
                @if (ReadExchanges(_selected).Count > 0)
                {
                    @foreach (var exchange in ReadExchanges(_selected))
                    {
                        <details class="exchange-section" open><summary>@exchange.HttpMethod @exchange.RequestUrl — HTTP @exchange.StatusCode</summary>
                        <div class="exchange-content"><h3>Request</h3><pre>@exchange.RequestHeaders</pre>@if (!string.IsNullOrWhiteSpace(exchange.RequestBody)) { <pre>@exchange.RequestBody</pre> }<h3>Response</h3><pre>@exchange.ResponseHeaders</pre><pre>@exchange.ResponseBody</pre></div></details>
                    }
                }
                else
                {
                    <h3>Request</h3><div class="request-url">@_selected.Url</div><pre>@_selected.RequestHeaders</pre>@if (!string.IsNullOrWhiteSpace(_selected.RequestBody)) { <pre>@_selected.RequestBody</pre> }
                    <h3>Response</h3><pre>@_selected.ResponseHeaders</pre><pre>@_selected.ResponseBody</pre>
                }
            }
            </div>
        }
    </section>
    }
</div>

@code {
    private IReadOnlyList<ApiRequestLog> _items = [];
    private IReadOnlyDictionary<string, string> _names = new Dictionary<string, string>();
    private ApiRequestLog? _selected;
    private SavedResultView? _result;
    private bool _technicalMode;
    private bool _missing;
    private int _loadVersion;
    private int _selectionVersion;

    protected override async Task OnInitializedAsync()
    {
        _names = Registry.List().ToDictionary(x => x.Id, x => x.Name, StringComparer.OrdinalIgnoreCase);
        Navigation.LocationChanged += OnLocationChanged;
        Workbench.ProfileChanged += OnProfileChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        var profileId = Workbench.ProfileId;
        _items = [];
        SetSelected(null, false);
        StateHasChanged();
        var items = profileId is Guid id ? await HistoryService.ListAsync(id) : [];
        if (version != _loadVersion || profileId != Workbench.ProfileId) return;
        _items = items;
        await SelectFromUrlAsync();
    }

    private async Task SelectFromUrlAsync()
    {
        var version = ++_selectionVersion;
        var profileId = Workbench.ProfileId;
        if (profileId is null) { SetSelected(null, false); return; }
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (query.TryGetValue("id", out var rawId))
        {
            if (Guid.TryParse(rawId.ToString(), out var id))
            {
                var item = _items.FirstOrDefault(x => x.Id == id) ?? await HistoryService.GetAsync(profileId.Value, id);
                if (version != _selectionVersion || profileId != Workbench.ProfileId) return;
                SetSelected(item, item is null);
            }
            else SetSelected(null, true);
        }
        else SetSelected(_items.FirstOrDefault(), false);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(async () =>
    {
        await SelectFromUrlAsync();
        StateHasChanged();
    });

    private void OnProfileChanged(object? sender, Guid? profileId) => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private void OpenHistory(Guid id) => Navigation.NavigateTo($"/history?id={id}");
    private void RequestRelatedCode(string code) => Navigation.NavigateTo($"/console?code={Uri.EscapeDataString(code)}", forceLoad: true);
    private void RequestDocument(CodeHistoryDocumentSelection selection) => Navigation.NavigateTo(
        QueryHelpers.AddQueryString(OperationNavigation.DocumentUrl(selection), "returnTo", SelectedReturnUrl()));
    private void RequestGtin(string gtin) => Navigation.NavigateTo(QueryHelpers.AddQueryString("/console",
        new Dictionary<string, string?> { ["gtin"] = gtin, ["returnTo"] = SelectedReturnUrl() }));
    private string SelectedReturnUrl() => Navigation.ToAbsoluteUri($"/history?id={_selected!.Id}").ToString();
    private void OnRowKeyDown(KeyboardEventArgs args, Guid id)
    {
        if (args.Key == "Enter") OpenHistory(id);
    }

    private void SetSelected(ApiRequestLog? item, bool missing)
    {
        _selected = item;
        _result = item is null ? null : SavedResultView.From(item);
        _missing = missing;
        _technicalMode = false;
    }

    private string OperationName(string id) => id switch
    {
        CodeCorrectionService.OperationId => "Корректировка сведений о кодах",
        "true-api.code-info-bulk-file" => "Запрос по кодам + (файл)",
        PackageAggregationService.OperationId => "Формирование упаковки",
        PackageTransformationService.OperationId => "Трансформация упаковки",
        _ => _names.GetValueOrDefault(id, "Другая операция")
    };
    private static string SystemName(ApiSystem system) => system switch
    {
        ApiSystem.TrueApi => "True API", ApiSystem.NationalCatalog => "Национальный каталог", ApiSystem.Suz => "СУЗ", ApiSystem.Mercury => "Меркурий", ApiSystem.PermitDocuments => "Разрешительные документы", _ => "Другая система"
    };

    private static IReadOnlyList<ApiHttpExchange> ReadExchanges(ApiRequestLog item)
    {
        if (string.IsNullOrWhiteSpace(item.ExchangesJson)) return [];
        try { return JsonSerializer.Deserialize<ApiHttpExchange[]>(item.ExchangesJson, new JsonSerializerOptions(JsonSerializerDefaults.Web)) ?? []; }
        catch (JsonException) { return []; }
    }

    public void Dispose()
    {
        ++_loadVersion;
        ++_selectionVersion;
        Navigation.LocationChanged -= OnLocationChanged;
        Workbench.ProfileChanged -= OnProfileChanged;
    }
}
