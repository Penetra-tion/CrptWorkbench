@using CrptWorkbench.Application

<div class="panel-title"><div><span class="eyebrow">Документ True API</span><h2>@(Results.Items.Count == 0 ? "Документ не найден" : "Результат проверки документа")</h2></div></div>
<IncrementalList Items="@Results.Items" Context="item" ResetKey="@Results.Items"><ChildContent>
    @{ var appearance = ResultStatusAppearance.ForDocument(item);
    var errors = DocumentStatusResults.ErrorTexts(item); }
    <article class="document-status-item">
        <div class="document-status-banner @appearance.CssClass" role="status">
            <span class="outcome-icon" aria-hidden="true">@appearance.Icon</span>
            <div><span class="outcome-label">Статус документа</span><strong>@DocumentStatusResults.Status(item.Status)</strong></div>
        </div>
        @if (!string.IsNullOrWhiteSpace(item.Number)) { <p class="document-id muted">ID: <code>@item.Number</code></p> }
        <div class="result-grid document-fields">
            <article class="result-field"><span>Время загрузки документа</span><strong>@DocumentStatusResults.ReceivedAt(item.ReceivedAt)</strong></article>
            <article class="result-field"><span>Тип документа</span><strong>@DocumentStatusResults.Type(item.Type)</strong></article>
            <article class="result-field"><span>Товарная группа</span><strong>@(item.ProductGroup is { Count: > 0 } ? string.Join(", ", item.ProductGroup.Select(DocumentStatusResults.Group)) : "Не указано")</strong></article>
        </div>
        @if (errors.Count > 0)
        {
            <div class="result-errors tone-error">
                <h3><span aria-hidden="true">!</span> Ошибки</h3>
                <ul><IncrementalList Items="@errors" Context="error" ResetKey="@item"><ChildContent> <li>@error</li> </ChildContent><ControlsContent Context="controls"><li>@controls</li></ControlsContent></IncrementalList></ul>
            </div>
        }
    </article>
</ChildContent></IncrementalList>

@code {
    [Parameter, EditorRequired] public DocumentStatusResults Results { get; set; } = null!;
}

