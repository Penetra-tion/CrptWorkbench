@using System.Globalization
@using System.Text.Json

@if (ShowSummary)
{
<div class="panel-title">
    <div><span class="eyebrow">Результат проверки кодов</span>
        <h2>@(Results.FoundCount == 0 ? "Коды не найдены" : Results.ErrorCount > 0 ? "Информация получена частично" : "Информация получена")</h2>
    </div>
</div>
<div class="metrics" role="status">
    <span>Всего <strong>@Results.Items.Count</strong></span>
    <span>Найдено <strong>@Results.FoundCount</strong></span>
    <span class="@(Results.ErrorCount > 0 ? "metric-errors" : null)">@if (Results.ErrorCount > 0) { <span aria-hidden="true">! </span> }Ошибок <strong>@Results.ErrorCount</strong></span>
</div>
}
<div class="code-result-list">
    <IncrementalList Items="@Results.Items" Context="item" ResetKey="@Results.Items"><ChildContent>
        @{ var info = item.CisInfo;
        var found = CodeInfoResults.IsFound(item);
        var appearance = ResultStatusAppearance.ForCode(item);
        var packageCode = CodeInfoResults.PackageTypeCode(info); }
        <article class="code-result-card">
            <header class="code-card-head">
                <div class="code-card-title">
                    <span class="package-label">@CodeInfoResults.PackageTypeLabel(info) @if (!string.IsNullOrWhiteSpace(packageCode)) { <small>@packageCode</small> }</span>
                    <h3>@(found ? ProductTitle(info) : "Сведения о коде недоступны")</h3>
                    @if (found && OmitsProductDetails(info) && string.IsNullOrWhiteSpace(info?.ProductName))
                    {
                        <p class="muted code-product-note">Название товара: @ProductValue(info)</p>
                    }
                </div>
                <span class="outcome-badge @appearance.CssClass"><span class="outcome-icon" aria-hidden="true">@appearance.Icon</span>@(found ? CodeInfoResults.StatusLabel(info?.Status) : string.IsNullOrWhiteSpace(item.ErrorCode) ? "Ошибка" : $"Ошибка {item.ErrorCode}")</span>
            </header>
            <div class="requested-code"><span class="eyebrow">Код маркировки</span><code>@(info?.RequestedCis ?? info?.Cis ?? "—")</code></div>
            @if (ShowOwnCodeAction && found && (info?.RequestedCis ?? info?.Cis) is { } ownCode)
            {
                <button type="button" class="button ghost" disabled="@Busy" @onclick="() => OnCodeSelected.InvokeAsync(ownCode)">Открыть код с историей документов</button>
            }
            @if (!found)
            {
                <div class="result-errors tone-error"><span aria-hidden="true">! </span>@(item.ErrorMessage ?? "Сведения о коде отсутствуют")</div>
            }
            @if (found && info is not null)
            {
                @if (!string.IsNullOrWhiteSpace(info.Cis) && info.Cis != info.RequestedCis)
                {
                    <div class="code-response-code"><span class="muted">Код из ответа</span><code>@info.Cis</code></div>
                }
                <dl class="code-primary-fields">
                    <div><dt>GTIN</dt><dd>@if (!string.IsNullOrWhiteSpace(info.Gtin)) { <button type="button" class="code-field-link" disabled="@Busy" title="Запросить товар в Национальном каталоге" @onclick="() => OnGtinSelected.InvokeAsync(info.Gtin)">@info.Gtin</button> } else { @GtinValue(info) }</dd></div>
                    @if (VsdValue(info) is { } vsd)
                    {
                        <div><dt>ВСД</dt><dd>@if (IsMercuryUid(vsd)) { <button type="button" class="code-field-link" disabled="@Busy" title="Запросить ВСД в Меркурии" @onclick="() => OnVsdSelected.InvokeAsync(vsd)">@vsd</button> } else { @vsd }</dd></div>
                    }
                    <div><dt>Владелец</dt><dd>@(info.OwnerName ?? "—") @if (info.OwnerInn is not null) { <small class="muted">ИНН @info.OwnerInn</small> }</dd></div>
                    @if (info.Status is "RETIRED" or "WITHDRAWN" or "WRITTEN_OFF")
                    {
                        <div><dt>Причина вывода</dt><dd>@WithdrawalReason(info)</dd></div>
                    }
                    @if (packageCode is "UNIT" or "GROUP" or "SET")
                    {
                        <div><dt>Оплата кода</dt><dd>@PaymentLabel(item.DocumentHistory)</dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(info.ProductGroup) || info.ProductGroupId.HasValue)
                    {
                        <div><dt>Товарная группа</dt><dd>@(info.ProductGroup ?? "—") @if (info.ProductGroupId.HasValue) { <small class="muted">ID @info.ProductGroupId</small> }</dd></div>
                    }
                    @if (info.ApplicationDate.HasValue)
                    {
                        <div><dt>Дата нанесения</dt><dd>@ApplicationDateValue(info)</dd></div>
                    }
                    @if (info.EmissionDate.HasValue)
                    {
                        <div><dt>Дата эмиссии</dt><dd>@FormatDate(info.EmissionDate)</dd></div>
                    }
                    @if (info.ProducedDate.HasValue)
                    {
                        <div><dt>Дата производства</dt><dd>@FormatDate(info.ProducedDate)</dd></div>
                    }
                    @if (info.ExpirationDate.HasValue || info.Expirations is { Count: > 0 })
                    {
                        <div class="code-expiration-field"><dt>Срок годности</dt><dd>
                            @if (info.Expirations is { Count: > 0 })
                            {
                                <div class="code-expiration-list">
                                    <IncrementalList Items="@info.Expirations" Context="expiration" ResetKey="@info.Expirations"><ChildContent>
                                        <span>@FormatDate(expiration.ExpirationStorageDate)@if (!string.IsNullOrWhiteSpace(expiration.StorageConditionName)) { <small class="muted">@expiration.StorageConditionName</small> }@if (expiration.StorageConditionId.HasValue) { <small class="muted">Условие хранения: @expiration.StorageConditionId</small> }</span>
                                    </ChildContent></IncrementalList>
                                </div>
                            }
                            else { @FormatDate(info.ExpirationDate) }
                        </dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(info.Parent))
                    {
                        <div class="code-parent-field"><dt>Родительская упаковка</dt><dd><button type="button" class="related-code-link" disabled="@Busy" title="Запросить сведения по коду" @onclick="() => OnCodeSelected.InvokeAsync(info.Parent)"><code>@info.Parent</code></button></dd></div>
                    }
                </dl>
                @if (HasPermits(info))
                {
                    <section class="code-permits" aria-label="Разрешительные документы">
                        <h4>Разрешительные документы</h4>
                        @if (info.CertDoc is { Count: > 0 })
                        {
                            <div class="permit-list">
                                <IncrementalList Items="@info.CertDoc" Context="document" ResetKey="@info.CertDoc"><ChildContent>
                                    @if (CanRequestPermit(document.Number))
                                    {
                                    <button type="button" class="permit-document permit-document-link" disabled="@Busy" title="Проверить документ в реестре" @onclick="() => OnPermitSelected.InvokeAsync(document.Number)">
                                        <strong>@CodeInfoResults.PermitDocumentTypeLabel(document.Type)</strong>
                                        @if (!string.IsNullOrWhiteSpace(document.Type)) { <span class="muted">@document.Type</span> }
                                        @if (!string.IsNullOrWhiteSpace(document.Number)) { <span>Номер: @document.Number</span> }
                                        @if (!string.IsNullOrWhiteSpace(document.Date)) { <span>Дата: @FormatPermitDate(document.Date)</span> }
                                        @if (!string.IsNullOrWhiteSpace(document.WellNumber)) { <span>Скважина: @document.WellNumber</span> }
                                        @if (document.Indx.HasValue) { <span>Индекс: @document.Indx</span> }
                                    </button>
                                    }
                                    else
                                    {
                                    <div class="permit-document">
                                        <strong>@CodeInfoResults.PermitDocumentTypeLabel(document.Type)</strong>
                                        @if (!string.IsNullOrWhiteSpace(document.Type)) { <span class="muted">@document.Type</span> }
                                        @if (!string.IsNullOrWhiteSpace(document.Number)) { <span>Номер: @document.Number</span> }
                                        @if (!string.IsNullOrWhiteSpace(document.Date)) { <span>Дата: @FormatPermitDate(document.Date)</span> }
                                        @if (!string.IsNullOrWhiteSpace(document.WellNumber)) { <span>Скважина: @document.WellNumber</span> }
                                        @if (document.Indx.HasValue) { <span>Индекс: @document.Indx</span> }
                                    </div>
                                    }
                                </ChildContent></IncrementalList>
                            </div>
                        }
                        else if (info.CertDocRequirementDetails is not null)
                        {
                            <div class="permit-document">
                                <strong>Документы отсутствуют</strong>
                                <span>@(info.CertDocRequirementDetails.NotRequiredReason ?? "Основание не указано")</span>
                                @if (info.CertDocRequirementDetails.IsRequired.HasValue)
                                {
                                    <span>Наличие причины отсутствия: @(info.CertDocRequirementDetails.IsRequired.Value ? "да" : "нет")</span>
                                }
                            </div>
                        }
                        @if (info.Licences is { Count: > 0 })
                        {
                            <div class="permit-list">
                                <IncrementalList Items="@(info.Licences.Where(licence => !string.IsNullOrWhiteSpace(licence.LicenceNumber) || !string.IsNullOrWhiteSpace(licence.LicenceDate)))" Context="licence" ResetKey="@info.Licences"><ChildContent>
                                    @if (!string.IsNullOrWhiteSpace(licence.LicenceNumber) || !string.IsNullOrWhiteSpace(licence.LicenceDate))
                                    {
                                        <div class="permit-document">
                                            @if (!string.IsNullOrWhiteSpace(licence.LicenceNumber)) { <span>Лицензия: @licence.LicenceNumber</span> }
                                            @if (!string.IsNullOrWhiteSpace(licence.LicenceDate)) { <span>Дата лицензии: @FormatPermitDate(licence.LicenceDate)</span> }
                                        </div>
                                    }
                                </ChildContent></IncrementalList>
                            </div>
                        }
                    </section>
                }
                @if (info.Child is { Count: > 0 } children)
                {
                    <details class="code-detail-disclosure code-bottom-disclosure">
                        <summary class="disclosure-toggle">Состав упаковки · @children.Count</summary>
                        <div class="disclosure-content">
                            <ul class="code-link-list">
                                <IncrementalList Items="@children" Context="child" ResetKey="@children"><ChildContent>
                                    <li><button type="button" class="related-code-link" disabled="@Busy" title="Запросить сведения по коду" @onclick="() => OnCodeSelected.InvokeAsync(child)"><code>@child</code></button></li>
                                </ChildContent><ControlsContent Context="controls"><li>@controls</li></ControlsContent></IncrementalList>
                            </ul>
                        </div>
                    </details>
                }
                @if (item.DocumentHistory?.Documents is { Count: > 0 } documents)
                {
                    <details class="code-detail-disclosure code-bottom-disclosure">
                        <summary class="disclosure-toggle">Документы по коду · @documents.Count</summary>
                        <div class="disclosure-content">
                            <IncrementalList Items="@documents" ResetKey="@documents"><ItemsContent Context="visibleDocuments"><div class="code-history-scroll">
                                <table class="code-history-table">
                                    <thead><tr><th>Операция</th><th>Дата обработки</th><th>Идентификатор</th><th>Отправитель</th><th>Получатель</th></tr></thead>
                                    <tbody>
                                        @foreach (var document in visibleDocuments)
                                        {
                                            <tr class="@(CodeHistoryDocumentLookup.IsValidId(document.DocumentId) ? "code-history-row-link" : null)" role="@(CodeHistoryDocumentLookup.IsValidId(document.DocumentId) ? "link" : null)" tabindex="@(CodeHistoryDocumentLookup.IsValidId(document.DocumentId) && !Busy ? "0" : null)" title="@(CodeHistoryDocumentLookup.IsValidId(document.DocumentId) ? "Запросить документ в API Console" : null)" @onclick="() => OpenHistoryDocument(document.DocumentId, info?.ProductGroup)" @onkeydown="args => OnHistoryRowKeyDown(args, document.DocumentId, info?.ProductGroup)">
                                                <td>
                                                    <span class="@(CodeHistoryDocumentLookup.IsValidId(document.DocumentId) ? "code-history-row-label" : null)">@DocumentTypeLabel(document.Type)</span>
                                                    @if (!string.IsNullOrWhiteSpace(document.Status)) { <small class="muted">@DocumentStatusResults.Status(document.Status)</small> }
                                                </td>
                                                <td>@FormatDate(document.ProcessedAt)</td>
                                                <td class="code-history-id">
                                                    <span class="@(CodeHistoryDocumentLookup.IsValidId(document.DocumentId) ? "code-history-row-label" : null)">@(document.DocumentId ?? "—")</span>
                                                </td>
                                                <td>@PartyLabel(document.SenderName, document.SenderInn)</td>
                                                <td>@PartyLabel(document.ReceiverName, document.ReceiverInn)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            </ItemsContent></IncrementalList>
                            @if (!string.IsNullOrWhiteSpace(item.DocumentHistory.Warning))
                            {
                                <p class="muted">@item.DocumentHistory.Warning</p>
                            }
                        </div>
                    </details>
                }
            }
        </article>
    </ChildContent></IncrementalList>
</div>

@code {
    [Parameter, EditorRequired] public CodeInfoResults Results { get; set; } = new([]);
    [Parameter] public EventCallback<string> OnCodeSelected { get; set; }
    [Parameter] public EventCallback<string> OnGtinSelected { get; set; }
    [Parameter] public EventCallback<string> OnVsdSelected { get; set; }
    [Parameter] public EventCallback<CodeHistoryDocumentSelection> OnDocumentSelected { get; set; }
    [Parameter] public EventCallback<string> OnPermitSelected { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool ShowSummary { get; set; } = true;
    [Parameter] public bool ShowOwnCodeAction { get; set; }

    private Task OpenHistoryDocument(string? documentId, string? productGroup) =>
        Busy || !CodeHistoryDocumentLookup.IsValidId(documentId)
            ? Task.CompletedTask
            : OnDocumentSelected.InvokeAsync(new CodeHistoryDocumentSelection(documentId!, ApiSystem.TrueApi, productGroup));

    private Task OnHistoryRowKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args, string? documentId, string? productGroup) =>
        args.Key is "Enter" or " " ? OpenHistoryDocument(documentId, productGroup) : Task.CompletedTask;

    private static bool OmitsProductDetails(CisInfo? info) => CodeInfoResults.PackageTypeCode(info) is "BOX" or "ATK";

    private static string WithdrawalReason(CisInfo info) =>
        string.Equals(info.WithdrawReason, "OTHER", StringComparison.OrdinalIgnoreCase) &&
        !string.IsNullOrWhiteSpace(info.WithdrawReasonOther)
            ? info.WithdrawReasonOther
            : CodeInfoResults.WithdrawalReasonLabel(info.WithdrawReason);

    private static bool HasPermits(CisInfo info) => info.CertDoc is { Count: > 0 } || info.Licences?.Any(x => !string.IsNullOrWhiteSpace(x.LicenceNumber) || !string.IsNullOrWhiteSpace(x.LicenceDate)) == true ||
        info.CertDocRequirementDetails is not null;

    private static bool CanRequestPermit(string? number)
    {
        try { PermitDocumentNumbers.Parse(number); return true; }
        catch (ArgumentException) { return false; }
    }

    private static string PaymentLabel(CodeDocumentHistory? history) => history is null ? "Не запрашивалась" : history.Paid switch
    {
        true => "Оплачен",
        false => "Не оплачен",
        null => "Не удалось проверить"
    };

    private static string DocumentTypeLabel(string? type) => type switch
    {
        "EMISSION" => "Эмиссия",
        "PAYMENT" => "Оплата",
        "APPLIED" => "Нанесение",
        "AGGREGATION_DOCUMENT" => "Формирование упаковки",
        "SETS_AGGREGATION" => "Формирование набора",
        "LP_INTRODUCE_GOODS" => "Ввод в оборот",
        null or "" => "Тип не указан",
        _ => DocumentStatusResults.Type(type)
    };

    private static string PartyLabel(string? name, string? inn) =>
        string.IsNullOrWhiteSpace(name) ? string.IsNullOrWhiteSpace(inn) ? "—" : $"ИНН {inn}" :
        string.IsNullOrWhiteSpace(inn) ? name : $"{name} · ИНН {inn}";

    private static string ProductTitle(CisInfo? info) => !string.IsNullOrWhiteSpace(info?.ProductName)
        ? info.ProductName
        : OmitsProductDetails(info) ? CodeInfoResults.PackageTypeLabel(info) : "Название товара не указано";

    private static string ProductValue(CisInfo? info) => !string.IsNullOrWhiteSpace(info?.ProductName)
        ? info.ProductName
        : OmitsProductDetails(info) ? "Не возвращается для этого типа" : "—";

    private static string GtinValue(CisInfo? info) => !string.IsNullOrWhiteSpace(info?.Gtin)
        ? info.Gtin
        : OmitsProductDetails(info) ? "Не возвращается для этого типа" : "—";

    private static string? VsdValue(CisInfo info) =>
        info.AdditionalFields?.TryGetValue("vsd", out var value) == true && value.ValueKind == JsonValueKind.String &&
        !string.IsNullOrWhiteSpace(value.GetString()) ? value.GetString() : null;

    private static bool IsMercuryUid(string vsd)
    {
        try
        {
            MercuryVsdInfoHandler.Parse(new Dictionary<string, string> { ["uid"] = vsd });
            return true;
        }
        catch (ArgumentException)
        {
            return false;
        }
    }

    private static string ApplicationDateValue(CisInfo info) => info.ApplicationDate.HasValue
        ? FormatDate(info.ApplicationDate)
        : OmitsProductDetails(info) ? "Не возвращается для этого типа" : "—";

    private static string FormatDate(DateTimeOffset? value) => value.HasValue
        ? value.Value.ToUniversalTime().ToString("dd.MM.yyyy HH:mm 'UTC'", CultureInfo.InvariantCulture)
        : "—";

    private static string FormatPermitDate(string value)
    {
        if (DateTimeOffset.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var timestamp))
            return timestamp.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture);
        if (DateOnly.TryParseExact(value, ["yyyy.MM.dd", "yyyy-MM-dd"], CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
            return date.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture);
        return value;
    }
}





