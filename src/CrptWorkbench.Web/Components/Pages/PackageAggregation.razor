@page "/package-aggregation"
@implements IAsyncDisposable
@using System.Text
@inject PackageAggregationService Aggregations
@inject PackageDocumentTracker DocumentTracker
@inject FavoriteProductGroupService FavoriteGroups
@inject WorkbenchContext Workbench
@inject IJSRuntime JavaScript
@inject IOptions<CrptIntegrationOptions> IntegrationOptions

<PageTitle>Формирование упаковок — CRPT Workbench</PageTitle>
<a class="operations-back" href="/operations"><span aria-hidden="true">←</span><span>Все операции</span></a>
<div class="page-heading"><div><span class="eyebrow">Операции</span><h1>Формирование упаковок</h1></div></div>

<div class="package-page">
<section class="panel form-section">
    <div class="panel-title"><h2>Подготовка</h2></div>
    <p class="muted">В каждой строке укажите код вложения и код упаковки через пробел или табуляцию. Одна упаковка создаёт один документ.</p>
    <div class="form-grid">
        <label class="checkbox-field"><input type="checkbox" @bind="_createSet" @bind:after="SetModeChanged" disabled="@_busy" /> Набор (КИН)</label>
        <div class="product-group-field">
            <span class="product-group-head">
                <label for="package-product-group">Товарная группа</label>
                <span class="package-group-filter" role="group" aria-label="Фильтр товарных групп">
                    <button type="button" class="@(!_favoriteGroupsOnly ? "active" : null)" @onclick="() => SetFavoriteGroupsOnlyAsync(false)" disabled="@_busy">Все</button>
                    <button type="button" class="@(_favoriteGroupsOnly ? "active" : null)" @onclick="() => SetFavoriteGroupsOnlyAsync(true)" disabled="@(_busy || _favoriteGroupCodes.Count == 0)">Избранные</button>
                </span>
            </span>
            <div class="product-group-picker">
                <select @key="(_createSet, _favoriteGroupsOnly)" id="package-product-group" value="@_group" @onchange="ChangeGroup" disabled="@_busy">
                    @foreach (var group in VisibleGroups) { <option value="@group.Code">@group.Name</option> }
                </select>
                <button type="button" class="favorite-toggle product-group-favorite @(IsFavoriteGroup(_group) ? "active" : null)" @onclick="ToggleFavoriteGroupAsync" disabled="@(_busy || Workbench.ProfileId is null)" aria-label="@(IsFavoriteGroup(_group) ? "Удалить товарную группу из избранного" : "Добавить товарную группу в избранное")" title="@(IsFavoriteGroup(_group) ? "Удалить из избранного" : "Добавить в избранное")">@(IsFavoriteGroup(_group) ? "★" : "☆")</button>
            </div>
        </div>
    </div>
    @if (_createSet)
    {
        <p class="notice">Состав КИН должен соответствовать карточке набора в Национальном каталоге. Вложения — единицы товара, для одежды также комплекты. Статусы, принадлежность и состав проверяет Честный ЗНАК.</p>
    }
    @if (!_createSet) { <p class="muted">КИТУ или КИГУ определяется в Честном ЗНАКе по коду упаковки. Для КИГУ состав должен соответствовать Национальному каталогу.</p> }
    <p class="muted">TXT в UTF-8. Ограничения на число строк нет. Сначала сформируйте нижний уровень упаковок и дождитесь успешной обработки, затем формируйте следующий.</p>
    <label class="package-text-label" for="package-text-input">Вставьте список кодов</label>
    <p class="muted package-input-help">Подойдёт текст из блокнота или две колонки из Excel. Разделяйте коды пробелом или табуляцией, каждую пару начинайте с новой строки.</p>
    @if (IntegrationOptions.Value.Mode == CrptIntegrationMode.Mock)
    {
        <details class="mock-example"><summary>Тестовые данные для Mock</summary><p class="muted">Для обычной упаковки выберите молочную продукцию. Для набора отметьте «Набор (КИН)» и используйте код набора во второй колонке.</p><pre>@(_createSet ? "010460000000000021DEMO000000001 0204600000000000371" : "010460000000000021DEMO000000001 000000000000000001")</pre></details>
    }
    <FileTextInput ZoneId="package-file-drop" FileId="package-file-input" Disabled="@_busy" OnFileChange="ReadFileAsync">
        <textarea id="package-text-input" rows="7" disabled="@_busy" spellcheck="false" placeholder="Код вложения    Код упаковки"></textarea>
    </FileTextInput>
    <TraceXSqlImport Columns="2" MaxBytes="9223372036854775807" Disabled="@_busy" OnApply="ApplyTraceXAsync" />
    <div class="actions"><button type="button" class="button ghost" @onclick="PreviewAsync" disabled="@_busy">Проверить строки</button></div>
    @if (_message is not null) { <p class="notice package-message @(_preview?.Errors.Count > 0 ? "error" : "")" role="status">@_message</p> }
</section>

@if (_preview is not null)
{
    <section class="panel">
        <h2>Предпросмотр: @_preview.Rows.Count вложений, @_preview.PackageCount упаковок</h2>
        @if (_preview.Errors.Count > 0) { <div class="notice error" role="alert"><IncrementalList Items="_preview.Errors" ResetKey="_preview" Context="error"><p>@error</p></IncrementalList></div> }
        @if (_preview.Rows.Count > 0)
        {
            <p class="muted">Будет отправлено документов: @_preview.PackageCount. Раскройте упаковку, чтобы проверить состав.</p>
            <div class="package-compositions">
                @foreach (var package in _preview.Rows.GroupBy(x => x.Package, StringComparer.Ordinal).Take(_visiblePackages))
                {
                    <details class="package-composition" @key="package.Key">
                        <summary><code>@package.Key</code><span>@package.Count() вложений</span></summary>
                        <div class="table-wrap"><table><thead><tr><th>Строка</th><th>Код вложения</th></tr></thead><tbody>
                            @foreach (var row in package.Take(_visibleItems.GetValueOrDefault(package.Key, 100))) { <tr><td>@row.Line</td><td><code>@row.Item</code></td></tr> }
                        </tbody></table></div>
                        <ShowMore VisibleCount="Math.Min(_visibleItems.GetValueOrDefault(package.Key, 100), package.Count())" TotalCount="package.Count()" HasMore="@(_visibleItems.GetValueOrDefault(package.Key, 100) < package.Count())" OnMore="() => ShowMoreItems(package.Key)" />
                    </details>
                }
            </div>
            <ShowMore VisibleCount="Math.Min(_visiblePackages, _preview.PackageCount)" TotalCount="_preview.PackageCount" HasMore="@(_visiblePackages < _preview.PackageCount)" OnMore="() => _visiblePackages += 100" />
        }
        <div class="actions submit-actions">
            <button type="button" class="button primary" @onclick="SubmitAsync" disabled="@(_busy || _preview.Errors.Count > 0 || _preview.Rows.Count == 0 || Workbench.ProfileId is null)">@(_busy ? "Отправляем…" : "Подписать и отправить")</button>
        </div>
    </section>
}

<section class="panel">
    <div class="panel-title"><h2>Отправленные документы</h2><button type="button" class="button ghost" @onclick="RefreshDocumentsAsync" disabled="@_busy">Обновить</button></div>
    @if (Workbench.ProfileId is null) { <p>Выберите профиль.</p> }
    else if (_loadingDocuments && _documents.Count == 0) { <p class="muted" role="status">Загружаем документы…</p> }
    else if (_documents.Count == 0) { <p class="muted">Документов пока нет.</p> }
    else
    {
        <div class="table-wrap"><table><thead><tr><th>Упаковка</th><th>GUID</th><th>Состояние</th><th>Последняя проверка</th><th>Следующая проверка</th><th></th></tr></thead><tbody>
            @foreach (var doc in _documents)
            {
                <tr><td><code>@doc.PackageCode</code><br /><small>@doc.ItemCount вложений · @(doc.PackageType switch { "SET" => "КИН", "GROUP" => "КИГУ", "BOX" => "КИТУ", _ => "КИТУ / КИГУ" }) · @(doc.Mode == CrptIntegrationMode.Production ? "PRODUCTION" : "MOCK")</small></td>
                    <td><code>@(doc.DocumentId ?? "—")</code></td>
                    <td>@StateLabel(doc)@if (!string.IsNullOrWhiteSpace(doc.RemoteStatus)) { <br /><small>@DocumentStatusResults.Status(doc.RemoteStatus)</small> }@if (!string.IsNullOrWhiteSpace(doc.Error)) { <br /><small class="error-text">@doc.Error</small> }</td>
                    <td>@Date(doc.LastCheckedAtUnixMs)</td>
                    <td>@Date(doc.NextCheckAtUnixMs)</td>
                    <td>@if (doc.DocumentId is not null && doc.State is "Paused" or "Tracking") { <button type="button" class="button ghost" @onclick="() => ContinueAsync(doc.Id, doc.State)" disabled="@_busy">@(doc.State == "Paused" ? "Возобновить на 24 часа" : "Проверить сейчас")</button> }</td></tr>
            }
        </tbody></table></div>
        <ShowMore VisibleCount="_documents.Count" TotalCount="_documentTotal" HasMore="@(_documentCursor is not null)" Loading="_loadingDocuments" Disabled="_busy" OnMore="LoadMoreDocumentsAsync" />
    }
</section>

</div>

@code {
    private const string FavoriteGroupsOnlyStorageKey = "crpt-workbench-package-aggregation-favorite-groups-only";

    private static readonly (string Code, string Name)[] Groups =
    [
        ("lp", "Одежда и бельё"), ("shoes", "Обувь"), ("perfumery", "Парфюмерия"), ("tires", "Шины"),
        ("electronics", "Фотокамеры"), ("milk", "Молочная продукция"), ("bicycle", "Велосипеды"),
        ("wheelchairs", "Медицинские изделия"), ("alcohol", "Слабоалкогольные напитки"), ("water", "Вода"),
        ("beer", "Пиво"), ("bio", "БАД"), ("antiseptic", "Антисептики"), ("petfood", "Корма для животных"),
        ("seafood", "Морепродукты"), ("nabeer", "Безалкогольное пиво"), ("softdrinks", "Соки и напитки"),
        ("vetpharma", "Ветеринарные препараты"), ("toys", "Игры и игрушки"), ("radio", "Радиоэлектроника"),
        ("conserve", "Консервы"), ("vegetableoil", "Растительные масла"), ("opticfiber", "Оптоволокно"),
        ("chemistry", "Косметика и бытовая химия"), ("books", "Печатная продукция"), ("grocery", "Бакалея"),
        ("construction", "Стройматериалы"), ("fire", "Пиротехника"), ("heater", "Отопительные приборы"),
        ("cableraw", "Кабели"), ("autofluids", "Моторные масла"), ("polymer", "Полимерные трубы"),
        ("sweets", "Сладости"), ("carparts", "Автозапчасти")
    ];
    private bool _createSet;
    private int _visiblePackages = 100;
    private readonly Dictionary<string, int> _visibleItems = new(StringComparer.Ordinal);
    private DotNetObjectReference<PackageAggregation>? _inputReference;
    private IEnumerable<(string Code, string Name)> SupportedGroups => Groups.Where(x => !_createSet || PackageSetRules.SupportsGroup(x.Code));
    private string _group = "milk";
    private string _text = string.Empty;
    private bool _busy;
    private bool _disposed;
    private bool _loadingDocuments;
    private int _contextVersion;
    private int _documentLoadVersion;
    private Guid? _previewProfileId;
    private bool _favoriteGroupsOnly;
    private string? _message;
    private TransformationPreview? _preview;
    private IReadOnlyList<PackageDocument> _documents = [];
    private RecordPageCursor? _documentCursor;
    private long? _documentTotal;
    private readonly HashSet<string> _favoriteGroupCodes = new(StringComparer.Ordinal);
    private IJSObjectReference? _dropModule;
    private readonly CancellationTokenSource _refreshCancellation = new();
    private IEnumerable<(string Code, string Name)> VisibleGroups =>
        _favoriteGroupsOnly && _favoriteGroupCodes.Count > 0
            ? SupportedGroups.Where(x => _favoriteGroupCodes.Contains(x.Code))
            : SupportedGroups;

    protected override void OnInitialized() => Workbench.ProfileChanged += ProfileChanged;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _favoriteGroupsOnly = await JavaScript.InvokeAsync<bool>("crptWorkbench.getLocalFlag", FavoriteGroupsOnlyStorageKey);
        _dropModule = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/package-drop.js");
        _inputReference = DotNetObjectReference.Create(this);
        await _dropModule.InvokeVoidAsync("attachText", "package-text-input", _inputReference);
        await LoadFavoriteGroupsAsync();
        await LoadAsync();
        StateHasChanged();
        _ = RefreshWhileOpenAsync();
    }
    private void ProfileChanged(object? sender, Guid? id) => _ = InvokeAsync(async () =>
    {
        _contextVersion++; ++_documentLoadVersion; _loadingDocuments = false;
        _text = string.Empty;
        if (_dropModule is not null) await _dropModule.InvokeVoidAsync("setText", "package-text-input", "");
        _preview = null;
        _previewProfileId = null;
        _message = null;
        _documents = []; _documentCursor = null; _documentTotal = null;
        _favoriteGroupCodes.Clear();
        await LoadFavoriteGroupsAsync();
        await LoadAsync();
        if (!_disposed) StateHasChanged();
    });
    [JSInvokable]
    public Task TextChanged() => InvokeAsync(() => { _preview = null; _message = null; StateHasChanged(); });
    private void SetModeChanged()
    {
        _preview = null;
        _message = null;
        if (!VisibleGroups.Any()) _favoriteGroupsOnly = false;
        if (!VisibleGroups.Any(x => x.Code == _group)) _group = VisibleGroups.FirstOrDefault().Code ?? SupportedGroups.First().Code;
    }
    private void ShowMoreItems(string package) => _visibleItems[package] = _visibleItems.GetValueOrDefault(package, 100) + 100;
    private async Task PreviewAsync()
    {
        if (_busy || _dropModule is null) return;
        _busy = true;
        var version = _contextVersion;
        try
        {
            await using var reference = await _dropModule.InvokeAsync<IJSStreamReference>("readText", "package-text-input");
            await using var stream = await reference.OpenReadStreamAsync(long.MaxValue, _refreshCancellation.Token);
            using var reader = new StreamReader(stream, new UTF8Encoding(false, true));
            var text = await reader.ReadToEndAsync(_refreshCancellation.Token);
            if (_disposed || version != _contextVersion) return;
            _text = text.TrimStart('\uFEFF');
            Preview();
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception) { if (!_disposed && version == _contextVersion) { _preview = null; _message = "Не удалось прочитать список кодов. Повторите проверку."; } }
        finally { _busy = false; }
    }
    private void ChangeGroup(ChangeEventArgs e) => _group = e.Value?.ToString() ?? _group;
    private bool IsFavoriteGroup(string groupCode) => _favoriteGroupCodes.Contains(groupCode);
    private async Task SetFavoriteGroupsOnlyAsync(bool favoriteOnly)
    {
        _favoriteGroupsOnly = favoriteOnly && SupportedGroups.Any(x => _favoriteGroupCodes.Contains(x.Code));
        if (_favoriteGroupsOnly && !_favoriteGroupCodes.Contains(_group))
            _group = VisibleGroups.FirstOrDefault().Code ?? _group;
        if (!_favoriteGroupsOnly && _favoriteGroupCodes.Contains(_group))
            _group = SupportedGroups.FirstOrDefault(x => !_favoriteGroupCodes.Contains(x.Code)).Code ?? _group;
        await JavaScript.InvokeVoidAsync("crptWorkbench.setLocalFlag", FavoriteGroupsOnlyStorageKey, _favoriteGroupsOnly);
    }
    private async Task ToggleFavoriteGroupAsync()
    {
        if (_busy || Workbench.ProfileId is not { } profileId) return;
        var version = _contextVersion;
        var group = _group;
        var makeFavorite = !_favoriteGroupCodes.Contains(group);
        try { await FavoriteGroups.SetAsync(profileId, group, makeFavorite, _refreshCancellation.Token); }
        catch (OperationCanceledException) when (_disposed) { return; }
        catch (Exception) { if (!_disposed && version == _contextVersion) _message = "Не удалось сохранить избранную товарную группу."; return; }
        if (_disposed || version != _contextVersion) return;
        if (makeFavorite) _favoriteGroupCodes.Add(group);
        else _favoriteGroupCodes.Remove(group);
        if (_favoriteGroupsOnly && !SupportedGroups.Any(x => _favoriteGroupCodes.Contains(x.Code)))
        {
            _favoriteGroupsOnly = false;
            await JavaScript.InvokeVoidAsync("crptWorkbench.setLocalFlag", FavoriteGroupsOnlyStorageKey, false);
        }
        if (_favoriteGroupsOnly && !_favoriteGroupCodes.Contains(_group))
            _group = VisibleGroups.FirstOrDefault().Code ?? SupportedGroups.First().Code;
    }
    private async Task LoadFavoriteGroupsAsync()
    {
        _favoriteGroupCodes.Clear();
        if (Workbench.ProfileId is null) { _favoriteGroupsOnly = false; return; }
        var version = _contextVersion;
        IReadOnlyList<string> codes;
        try { codes = await FavoriteGroups.ListAsync(Workbench.ProfileId.Value, _refreshCancellation.Token); }
        catch (OperationCanceledException) when (_disposed) { return; }
        catch (Exception) { if (!_disposed && version == _contextVersion) _message = "Не удалось загрузить избранные товарные группы."; return; }
        if (_disposed || version != _contextVersion) return;
        foreach (var groupCode in codes)
            if (Groups.Any(x => x.Code == groupCode)) _favoriteGroupCodes.Add(groupCode);
        if (_favoriteGroupsOnly && !SupportedGroups.Any(x => _favoriteGroupCodes.Contains(x.Code)))
            _favoriteGroupsOnly = false;
        if (_favoriteGroupsOnly && !_favoriteGroupCodes.Contains(_group))
            _group = VisibleGroups.FirstOrDefault().Code ?? _group;
    }
    private async Task RefreshWhileOpenAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
            while (await timer.WaitForNextTickAsync(_refreshCancellation.Token))
                await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        }
        catch (OperationCanceledException) { }
    }
    private async Task ReadFileAsync(InputFileChangeEventArgs e)
    {
        if (_busy) return;
        var version = _contextVersion;
        _busy = true;
        _preview = null;
        try
        {
            await using var stream = e.File.OpenReadStream(long.MaxValue);
            using var reader = new StreamReader(stream, new UTF8Encoding(false, true), detectEncodingFromByteOrderMarks: false);
            var text = await reader.ReadToEndAsync(_refreshCancellation.Token);
            if (_disposed || version != _contextVersion) return;
            _text = text.TrimStart('\uFEFF');
            if (_dropModule is not null) await _dropModule.InvokeVoidAsync("setText", "package-text-input", _text);
            Preview();
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception) { if (version == _contextVersion) { _message = "Не удалось прочитать TXT. Нужен текстовый файл в UTF-8."; _preview = null; } }
        finally { _busy = false; }
    }
    private async Task ApplyTraceXAsync((string Text, bool Append) import)
    {
        if (_dropModule is null) return;
        var existing = "";
        if (import.Append)
        {
            await using var reference = await _dropModule.InvokeAsync<IJSStreamReference>("readText", "package-text-input");
            await using var stream = await reference.OpenReadStreamAsync(long.MaxValue, _refreshCancellation.Token);
            using var reader = new StreamReader(stream, new UTF8Encoding(false, true));
            existing = await reader.ReadToEndAsync(_refreshCancellation.Token);
        }
        _text = string.IsNullOrWhiteSpace(existing) ? import.Text : existing.TrimEnd() + "\n" + import.Text;
        await _dropModule.InvokeVoidAsync("setText", "package-text-input", _text);
        _preview = null; _previewProfileId = null; _message = "Загружено строк из TraceX.";
    }
    private void Preview() { _visiblePackages = 100; _visibleItems.Clear(); _preview = PackageAggregationService.Parse(_text, _createSet); _previewProfileId = Workbench.ProfileId; _message = _preview.Errors.Count == 0 ? "Строки проверены. Можно отправлять документы." : "Исправьте ошибки в файле или поле ввода."; }
    private async Task SubmitAsync()
    {
        if (_busy || _preview is null || _preview.Errors.Count > 0 || _preview.Rows.Count == 0 || Workbench.ProfileId is not { } profileId || _previewProfileId != profileId) return;
        var version = _contextVersion;
        _busy = true;
        try
        {
            ++_documentLoadVersion; _loadingDocuments = false; _documents = []; _documentCursor = null; _documentTotal = null;
            var sent = await Aggregations.SubmitAsync(profileId, _group, _createSet ? "SET" : "AUTO", _preview.Rows, _refreshCancellation.Token);
            if (_disposed || version != _contextVersion) return;
            _message = $"Создано заданий: {sent.Count}. Статусы обновляются автоматически.";
            _preview = null;
            _documents = []; _documentCursor = null; _documentTotal = null;
            await LoadAsync();
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception) { if (version == _contextVersion) { _message = "Отправка прервана. Проверьте результаты документов перед новой отправкой."; await LoadAsync(); } }
        finally { _busy = false; }
    }
    private Task LoadAsync() => LoadDocumentsAsync(false);
    private Task RefreshDocumentsAsync()
    {
        ++_documentLoadVersion;
        _loadingDocuments = false;
        _documents = []; _documentCursor = null; _documentTotal = null;
        return LoadAsync();
    }
    private Task LoadMoreDocumentsAsync() => LoadDocumentsAsync(true);
    private async Task LoadDocumentsAsync(bool append)
    {
        if (_loadingDocuments || (append && _documentCursor is null)) return;
        var load = ++_documentLoadVersion; var context = _contextVersion; var profile = Workbench.ProfileId;
        _loadingDocuments = true;
        try
        {
            if (profile is not { } id) { _documents = []; _documentCursor = null; _documentTotal = null; return; }
            if (!append && _documents.Count > 0)
            {
                var refreshed = await Aggregations.GetManyAsync(id, _documents.Select(x => x.Id).ToArray(), _refreshCancellation.Token);
                if (!_disposed && context == _contextVersion && load == _documentLoadVersion)
                {
                    if (_documentTotal is { } total) _documentTotal = Math.Max(refreshed.Count, total - (_documents.Count - refreshed.Count));
                    _documents = refreshed;
                }
            }
            else
            {
                var page = await Aggregations.ListPageAsync(id, append ? _documentCursor : null, _refreshCancellation.Token);
                if (!_disposed && context == _contextVersion && load == _documentLoadVersion)
                {
                    _documents = append ? _documents.Concat(page.Items).DistinctBy(x => x.Id).ToArray() : page.Items;
                    _documentCursor = page.NextCursor; _documentTotal = page.TotalCount;
                }
            }
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception) { if (!_disposed && context == _contextVersion && load == _documentLoadVersion) _message = "Не удалось обновить документы. Повторите обновление."; }
        finally { if (load == _documentLoadVersion) _loadingDocuments = false; }
    }
    private async Task ContinueAsync(Guid id, string state)
    {
        if (_busy || Workbench.ProfileId is not { } profileId) return;
        var version = _contextVersion;
        _busy = true;
        try
        {
            if (state == "Paused") await Aggregations.ResumeAsync(profileId, id, _refreshCancellation.Token);
            else await Aggregations.CheckNowAsync(profileId, id, _refreshCancellation.Token);
            await DocumentTracker.PollDueAsync(_refreshCancellation.Token);
            if (_disposed || version != _contextVersion) return;
            _message = state == "Paused" ? "Отслеживание возобновлено." : "Проверка выполнена.";
        }
        catch (Exception)
        {
            if (!_disposed && version == _contextVersion) _message = "Проверка не выполнена. Повторите попытку позже.";
        }
        finally
        {
            if (!_disposed) await LoadAsync();
            _busy = false;
        }
    }
    private static string StateLabel(PackageDocument x) => x.State switch
    {
        "Tracking" => "Проверяется", "Finished" => "Обработка завершена", "Paused" => "Отслеживание приостановлено",
        "Unknown" or "Sending" => "Результат отправки неизвестен", "Rejected" => "Не отправлен", "Prepared" => "Подготовка прервана; не отправлен", _ => x.State
    };
    private static string Date(long? unixMs) => unixMs is null ? "—" : DateTimeOffset.FromUnixTimeMilliseconds(unixMs.Value).ToLocalTime().ToString("dd.MM.yyyy HH:mm");
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Workbench.ProfileChanged -= ProfileChanged;
        await _refreshCancellation.CancelAsync();
        _refreshCancellation.Dispose();
        if (_dropModule is not null) { try { await _dropModule.InvokeVoidAsync("detachText", "package-text-input"); await _dropModule.DisposeAsync(); } catch (JSDisconnectedException) { } }
        _inputReference?.Dispose();
    }
}
