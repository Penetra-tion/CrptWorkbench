    private async Task RequestHistoryDocumentAsync(CodeHistoryDocumentSelection selection)
    {
        if (_running) return;
        if (Workbench.ProfileId is null)
        {
            _validationError = "Выберите профиль для запроса документа.";
            return;
        }
        if (!CodeHistoryDocumentLookup.IsValidId(selection.DocumentId))
        {
            _validationError = "Недопустимый идентификатор документа.";
            return;
        }
        SelectOperation(_operations.FirstOrDefault(x => x.Id == (selection.Source == ApiSystem.Suz
            ? SuzDocumentStatusHandler.OperationId : TrueApiDocumentStatusHandler.OperationId)));
        _values["documentId"] = selection.DocumentId;
        if (selection.ProductGroup == "furs" && selection.Source == ApiSystem.TrueApi) _values["productGroup"] = "furs";
        _technicalMode = false;
        _running = true;
        _executionCancellation = new CancellationTokenSource();
        var cancellation = _executionCancellation;
        var version = ++_executionVersion;
        var profileId = Workbench.ProfileId.Value;
        StateHasChanged();
        try
        {
            var lookup = await DocumentLookup.ExecuteAsync(selection, profileId, cancellation.Token);
            if (_disposed || version != _executionVersion || profileId != Workbench.ProfileId) return;
            var operationId = lookup.System == ApiSystem.Suz ? SuzDocumentStatusHandler.OperationId : TrueApiDocumentStatusHandler.OperationId;
            if (_selected?.Id != operationId)
            {
                SelectOperation(_operations.FirstOrDefault(x => x.Id == operationId));
                _values["documentId"] = selection.DocumentId;
            }
            _result = lookup.Result;
            _documentStatusResults = lookup.System == ApiSystem.TrueApi && _result.Success ? DocumentStatusResults.Parse(_result.ResponseBody) : null;
            _suzDocumentStatusResults = lookup.System == ApiSystem.Suz && _result.Success ? SuzDocumentStatusResults.Parse(_result.ResponseBody) : null;
            _friendlyResult = BuildFriendlyResult(_result.ResponseBody);
            _documentLookupMissing = lookup.NotFound;
            _documentLookupNotice = lookup.NotFound
                ? lookup.CheckedBothSystems ? "Документ не найден ни в True API, ни в СУЗ." : $"Документ не найден в {(lookup.System == ApiSystem.Suz ? "СУЗ" : "True API")}."
                : lookup.Result.Success ? $"Документ получен из {(lookup.System == ApiSystem.Suz ? "СУЗ" : "True API")}."
                    : $"Запрос документа в {(lookup.System == ApiSystem.Suz ? "СУЗ" : "True API")} завершился ошибкой.";
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            if (!_disposed && version == _executionVersion && profileId == Workbench.ProfileId)
                _validationError = "Запрос отменён.";
        }
        finally
        {
            cancellation.Dispose();
            if (version == _executionVersion)
            {
                _running = false;
                _executionCancellation = null;
            }
        }
    }

    private string GetValue(string name) => _values.GetValueOrDefault(name, string.Empty);
    private Task ApplyTraceXCodesAsync((string Text, bool Append) import)
    {
        var value = import.Append && !string.IsNullOrWhiteSpace(GetValue("codes"))
            ? GetValue("codes").TrimEnd() + "\n" + import.Text.Trim()
            : import.Text.Trim();
        if (Encoding.UTF8.GetByteCount(value) > 1_000_000)
            throw new InvalidDataException("Общий список слишком велик для поля. Используйте фоновое задание.");
        SetValue("codes", value);
        return Task.CompletedTask;
    }
    private void SetValue(string name, string? value)
    {
        _values[name] = value ?? string.Empty;
        _fieldValidation = new([]);
        _validationError = null;
    }
    private async Task ReadCodesFileAsync(InputFileChangeEventArgs e)
    {
        try
        {
            const int maxBytes = 1_000_000;
            await using var stream = e.File.OpenReadStream(maxBytes);
            using var reader = new StreamReader(stream, new UTF8Encoding(false, true));
            SetValue("codes", await reader.ReadToEndAsync());
        }
        catch (Exception)
        {
            _validationError = "Не удалось прочитать TXT. Нужен файл UTF-8 размером до 1 МБ.";
        }
    }

    private async Task UploadBulkFileAsync(InputFileChangeEventArgs e)
    {
        if (Workbench.ProfileId is not { } profileId) { _bulkFileError = "Выберите профиль."; return; }
        _bulkUploading = true;
        _bulkFileError = null;
        try
        {
            await using var stream = e.File.OpenReadStream(long.MaxValue, _bulkPollCancellation.Token);
            await BulkFiles.UploadAsync(profileId, e.File.Name, e.File.Size, stream, _bulkPollCancellation.Token);
            await ResetBulkJobsAsync();
        }
        catch (OperationCanceledException) when (_bulkPollCancellation.IsCancellationRequested) { }
        catch (Exception exception)
        {
            _bulkFileError = exception is IOException ? "Не удалось сохранить файл: проверьте свободное место на диске." : "Не удалось загрузить TXT-файл.";
        }
        finally { _bulkUploading = false; }
    }

    private async Task RefreshBulkJobsAsync()
    {
        if (_bulkJobsLoading) return;
        var profileId = Workbench.ProfileId;
        var version = _bulkJobsVersion;
        IReadOnlyList<BulkCodeJob> jobs = [];
        if (!_bulkJobsInitialized || _bulkJobsProfileId != profileId)
        {
            _bulkJobsProfileId = profileId;
            _bulkJobsInitialized = false;
            _bulkJobs = [];
            _bulkJobsCursor = null;
            _bulkJobsTotal = null;
            version = ++_bulkJobsVersion;
            if (profileId is { } id)
            {
                var page = await BulkFiles.ListPageAsync(id, cancellationToken: _bulkPollCancellation.Token);
                if (version != _bulkJobsVersion || profileId != Workbench.ProfileId) return;
                jobs = page.Items;
                _bulkJobsCursor = page.NextCursor;
                _bulkJobsTotal = page.TotalCount;
            }
            _bulkJobsInitialized = true;
        }
        else if (profileId is { } id)
        {
            var loadedCount = _bulkJobs.Count;
            jobs = await BulkFiles.GetManyAsync(id, _bulkJobs.Select(x => x.Id).ToArray(), _bulkPollCancellation.Token);
            if (version != _bulkJobsVersion || profileId != Workbench.ProfileId) return;
            if (_bulkJobsTotal.HasValue) _bulkJobsTotal = Math.Max(0, _bulkJobsTotal.Value - (loadedCount - jobs.Count));
        }
        if (version != _bulkJobsVersion || profileId != Workbench.ProfileId) return;
        _bulkJobs = jobs;
        await InvokeAsync(StateHasChanged);
        if (_bulkCountsProfileId != profileId)
        {
            _bulkStatusCounts.Clear();
            _bulkCountsProfileId = profileId;
        }
        var currentIds = jobs.Select(job => job.Id).ToHashSet();
        foreach (var id in _bulkStatusCounts.Keys.Where(id => !currentIds.Contains(id)).ToArray())
            _bulkStatusCounts.Remove(id);
        foreach (var job in jobs)
        {
            if (_bulkStatusCounts.TryGetValue(job.Id, out var cached) && cached.Completed == job.CodesCompleted) continue;
            IReadOnlyDictionary<string, long> counts;
            try
            {
                counts = await BulkFiles.CountCodesByStatusAsync(profileId!.Value, job.Id, _bulkPollCancellation.Token);
            }
            catch (Exception exception) when (exception is InvalidOperationException or FileNotFoundException or DirectoryNotFoundException)
            {
                if (await BulkFiles.GetAsync(profileId!.Value, job.Id, _bulkPollCancellation.Token) is null) continue;
                throw;
            }
            if (profileId != Workbench.ProfileId) return;
            _bulkStatusCounts[job.Id] = (job.CodesCompleted, counts);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetBulkJobsAsync()
    {
        _bulkJobsVersion++;
        _bulkJobsInitialized = false;
        _bulkJobsLoading = false;
        try { await RefreshBulkJobsAsync(); }
        catch (OperationCanceledException) when (_bulkPollCancellation.IsCancellationRequested) { }
        catch (Exception) { _bulkFileError = "Не удалось загрузить задания. Нажмите «Обновить», чтобы повторить."; }
    }

    private async Task LoadMoreBulkJobsAsync()
    {
        if (_bulkJobsLoading || _bulkJobsCursor is null || Workbench.ProfileId is not { } id) return;
        var version = ++_bulkJobsVersion;
        _bulkJobsLoading = true;
        _bulkFileError = null;
        try
        {
            var page = await BulkFiles.ListPageAsync(id, _bulkJobsCursor, _bulkPollCancellation.Token);
            if (version != _bulkJobsVersion || id != Workbench.ProfileId) return;
            _bulkJobs = _bulkJobs.Concat(page.Items).DistinctBy(x => x.Id).ToArray();
            _bulkJobsCursor = page.NextCursor;
            _bulkJobsLoading = false;
            await RefreshBulkJobsAsync();
        }
        catch (OperationCanceledException) when (_bulkPollCancellation.IsCancellationRequested) { }
        catch (Exception)
        {
            if (version == _bulkJobsVersion && id == Workbench.ProfileId)
                _bulkFileError = "Не удалось загрузить следующие задания. Повторите загрузку.";
        }
        finally { if (version == _bulkJobsVersion) _bulkJobsLoading = false; }
    }

    private async Task PollBulkJobsAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(_bulkPollCancellation.Token))
            {
                if (_selected?.Id != TrueApiBulkCodeInfoHandler.OperationId) continue;
                try { await RefreshBulkJobsAsync(); }
                catch (OperationCanceledException) when (_bulkPollCancellation.IsCancellationRequested) { break; }
                catch (Exception exception) { Logger.LogWarning(exception, "Bulk job list refresh failed"); }
            }
        }
        catch (OperationCanceledException) when (_bulkPollCancellation.IsCancellationRequested) { }
    }

