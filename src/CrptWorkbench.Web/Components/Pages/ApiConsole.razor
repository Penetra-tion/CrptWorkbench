        Uri.TryCreate(url, UriKind.Absolute, out var parsed) &&
        parsed.GetLeftPart(UriPartial.Authority) == Navigation.ToAbsoluteUri("/").GetLeftPart(UriPartial.Authority) &&
        parsed.AbsolutePath is "/console" or "/history"
            ? url : null;

