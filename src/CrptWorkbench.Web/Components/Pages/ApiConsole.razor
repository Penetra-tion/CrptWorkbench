@inject ILogger<ApiConsole> Logger
@page "/console"
@implements IAsyncDisposable
@using System.Text.Json
@using System.Text
@using Microsoft.AspNetCore.WebUtilities
@using CrptWorkbench.Domain
@inject IApiOperationRegistry Registry
@inject ExecuteApiOperationService Executor
@inject CodeHistoryDocumentLookup DocumentLookup
@inject BulkCodeFileService BulkFiles
@inject BulkCodeDownloadTickets BulkTickets
@inject ProfileService Profiles
@inject WorkbenchContext Workbench
@inject IJSRuntime JavaScript
@inject IOptions<CrptIntegrationOptions> IntegrationOptions
@inject NavigationManager Navigation

<PageTitle>Получение сведений — CRPT Workbench</PageTitle>

<a class="operations-back" href="/operations"><span aria-hidden="true">←</span><span>Все операции</span></a>
@if (_returnUrl is not null)
{
    <button type="button" class="button ghost" disabled="@_running" @onclick="ReturnToCodes">← Назад к запросу кодов</button>
}
<div class="page-heading console-heading">
    <div><span class="eyebrow">Операции</span><h1>Получение сведений</h1></div>
</div>

<div class="notice production-notice"><strong>@ModeHeadline</strong> @ModeDescription</div>
@if (_unknownOperation)
{
    <div class="notice error" role="alert">Операция не найдена. <a href="/operations">Выберите задачу в каталоге операций.</a></div>
}
@if (_documentLookupNotice is not null)
{
    <div class="notice @(_documentLookupMissing ? "error" : "")" role="status">@_documentLookupNotice</div>
}

<div class="console-grid">
    <section class="panel editor">
        @if (_selected is not null)
        {
            <div class="operation-title">
                <div><span class="eyebrow">@SystemName(_selected.System)</span><h2>@_selected.Name</h2></div>
                <span class="method-badge large">@_selected.HttpMethod</span>
            </div>

            <p class="muted">@_selected.Description</p>

            <div class="field-grid">
                @foreach (var field in _selected.Fields)
                {
                    @if (field.Name == "codes" && _selected.Id is TrueApiCodeInfoHandler.OperationId or TrueApiBulkCodeInfoHandler.OperationId)
                    {
                        <div class="file-text-field">
                            <label for="code-text-input">@field.Label</label>
                            <FileTextInput @key="_selected.Id" ZoneId="code-file-drop" FileId="code-file-input" Disabled="@(_running || _bulkUploading)" Hint="@(_selected.Id == TrueApiBulkCodeInfoHandler.OperationId ? "TXT-файл запускает фоновую обработку и не помещается в поле." : null)" OnFileChange="@(_selected.Id == TrueApiBulkCodeInfoHandler.OperationId ? UploadBulkFileAsync : ReadCodesFileAsync)">
                                <textarea id="code-text-input" rows="7" value="@GetValue(field.Name)" @oninput="args => SetValue(field.Name, args.Value?.ToString())" placeholder="@field.Placeholder" required="@field.Required" disabled="@(_running || _bulkUploading)" spellcheck="false" aria-describedby="@($"help-{field.Name}")"></textarea>
                            </FileTextInput>
                            <TraceXSqlImport @key="TraceXImportKey" Columns="1" MaxBytes="1000000" Bulk="@(_selected.Id == TrueApiBulkCodeInfoHandler.OperationId)" Disabled="@(_running || _bulkUploading)" OnApply="ApplyTraceXCodesAsync" OnBulkPrepared="ResetBulkJobsAsync" />
                            @if (GetFieldHelp(field.HelpText) is not null) { <small id="@($"help-{field.Name}")" class="muted field-help">@GetFieldHelp(field.HelpText)</small> }
                            @if (_fieldValidation.ErrorFor(field.Name) is { } fieldError) { <small class="error-text" role="alert">@fieldError</small> }
                        </div>
                    }
                    else
                    {
                    <label class="@(field.CheckedValue is null ? null : "checkbox-field")">
                        @if (field.CheckedValue is not null)
                        {
                            <input type="checkbox" checked="@(GetValue(field.Name) == field.CheckedValue)" @onchange="args => SetValue(field.Name, args.Value is true ? field.CheckedValue : string.Empty)" disabled="@_running" aria-describedby="@($"help-{field.Name}")" />
                            <span>@field.Label</span>
                        }
                        else if (field.Multiline)
                        {
                            @field.Label
                            <textarea rows="7" value="@GetValue(field.Name)" @oninput="args => SetValue(field.Name, args.Value?.ToString())" placeholder="@field.Placeholder" required="@field.Required" disabled="@_running" spellcheck="false" aria-describedby="@($"help-{field.Name}")"></textarea>
                        }
                        else
                        {
                            @field.Label
                            <input value="@GetValue(field.Name)" @oninput="args => SetValue(field.Name, args.Value?.ToString())" placeholder="@field.Placeholder" required="@field.Required" disabled="@_running" aria-describedby="@($"help-{field.Name}")" />
                        }
                        @if (GetFieldHelp(field.HelpText) is not null) { <small id="@($"help-{field.Name}")" class="muted field-help">@GetFieldHelp(field.HelpText)</small> }
                        @if (_fieldValidation.ErrorFor(field.Name) is { } fieldError) { <small class="error-text" role="alert">@fieldError</small> }
                    </label>
                    }
                }
            </div>

            @if (_selected.Id == TrueApiBulkCodeInfoHandler.OperationId)
            {
                @if (_bulkUploading) { <p role="status">Загружаем файл на сервер…</p> }
                @if (_bulkFileError is not null) { <p class="error-text" role="alert">@_bulkFileError</p> }
                <fieldset class="bulk-status-filter">
                    <legend>Показывать КМ в статусах</legend>
                    <div class="bulk-status-options">
                        @foreach (var status in BulkStatuses)
                        {
                            <label><input type="checkbox" checked="@_bulkStatuses.Contains(status.Code)" @onchange="args => SetBulkStatus(status.Code, args.Value is true)" disabled="@_running" /><span>@status.Label</span></label>
                        }
                        <label><input type="checkbox" checked="@_bulkPaidOnly" @onchange="args => SetBulkPaidOnly(args.Value is true)" disabled="@_running" /><span>Оплачен</span></label>
                    </div>
                </fieldset>
                <div class="bulk-jobs">
                    <div class="actions bulk-jobs-heading"><strong>Файловые задания</strong><button type="button" class="button ghost" @onclick="ResetBulkJobsAsync">Обновить</button></div>
                    @if (_bulkJobs.Count == 0) { <p class="muted">Заданий пока нет.</p> }
                    @foreach (var job in _bulkJobs)
                    {
                        <div @key="job.Id" class="panel bulk-job">
                            <strong>@job.FileName</strong>
                            <p>Состояние: @BulkStateLabel(job.State). Обработано @job.CodesCompleted кодов; найдено @job.CodesFound; ошибок по кодам @job.CodeErrors; партий с ошибкой @job.FailedBatches.</p>
                            <progress value="@job.NextOffset" max="@Math.Max(1, job.FileBytes)"></progress>
                            <small class="muted">Прочитано @job.LinesRead строк; @job.NextOffset из @job.FileBytes байт.</small>
                            @if (job.State == "Partial") { <p class="error-text">Результат неполный: часть партий завершилась ошибкой.</p> }
                            @if (job.Error is not null) { <p class="error-text">@job.Error</p> }
                            <BulkCodeSummary Counts="@JobCounts(job.Id)" SelectedCount="@SelectedBulkCount(job.Id)"
                                             CanPreview="@(job.State == "Completed")"
                                             PreviewKey="@($"{Workbench.ProfileId}:{job.Id}:{string.Join(',', SelectedBulkStatuses.Order())}")"
                                             PreviewPageLoader="@(cursor => PreviewBulkJobAsync(job.Id, cursor))" OnDownload="@(() => DownloadBulkAsync(job.Id))" />
                            <div class="actions">
                                @if (job.State == "Ready") { <button type="button" class="button primary" @onclick="() => StartReadyBulkJobAsync(job.Id)">Запустить проверку</button> }
                                @if (job.State is "Queued" or "Running") { <button type="button" class="button ghost" @onclick="() => CancelBulkJobAsync(job.Id)">Отменить</button> }
                                @if (job.State == "Partial") { <button type="button" class="button ghost" @onclick="() => RetryBulkJobAsync(job.Id)">Повторить ошибки</button> }
                                @if (job.State == "Failed" && job.Error?.StartsWith("Недостаточно места", StringComparison.Ordinal) == true) { <button type="button" class="button ghost" @onclick="() => ResumeBulkJobAsync(job.Id)">Продолжить</button> }
                                @if (job.State is "Ready" or "Completed" or "Partial" or "Canceled" or "Failed") { <button type="button" class="button ghost" @onclick="() => DeleteBulkJobAsync(job.Id)">Удалить</button> }
                            </div>
                        </div>
                    }
                    <ShowMore VisibleCount="@_bulkJobs.Count" TotalCount="@_bulkJobsTotal" HasMore="@(_bulkJobsCursor is not null)" Loading="@_bulkJobsLoading" OnMore="LoadMoreBulkJobsAsync" />
                </div>
            }

            @if (!IsProduction && MockExamples.TryGetValue(_selected.Id, out var example))
            {
                <div class="mock-example">
                    <span><strong>Тестовые данные для Mock:</strong> <code>@example.Display</code></span>
                    <button type="button" class="button ghost" disabled="@_running" @onclick="() => ApplyMockExample(example)">Подставить</button>
                </div>
            }
            @if (!IsProduction && _selected.Id == TrueApiCodeInfoHandler.OperationId)
            {
                <div class="mock-example">
                    <span><strong>Транспортная упаковка со 100 КМ:</strong> <code>000000000000000100</code></span>
                    <button type="button" class="button ghost" disabled="@_running" @onclick="ApplyLargeBoxExample">Подставить</button>
                </div>
            }

            <div class="actions editor-actions submit-actions">
                <button type="button" class="button primary execute-button" @onclick="ExecuteAsync" disabled="@_running">
                    <span aria-hidden="true">@(_running ? "◌" : "→")</span>@(_running ? "Выполняется…" : "Получить информацию")
                </button>
                @if (_running && _selected.Id is TrueApiBulkCodeInfoHandler.OperationId or TrueApiAggregationTreeHandler.OperationId)
                {
                    <button type="button" class="button ghost" @onclick="CancelBulk">Отменить</button>
                }
            </div>
            @if (_running && _selected.Id == TrueApiAggregationTreeHandler.OperationId)
            {
                <p role="status" aria-live="polite">@(_treeProgress?.Stage ?? "Подготовка загрузки") · обработано @(_treeProgress?.ProcessedCodes ?? 0) кодов</p>
            }
            @if (!string.IsNullOrWhiteSpace(_validationError))
            {
                <p class="error-text" role="alert">@_validationError</p>
            }
        }
    </section>
</div>

@if (_result is not null)
{
    <section @key="_result.CorrelationId" class="panel response-viewer result-enter">
        @if (_selected?.Id != TrueApiBulkCodeInfoHandler.OperationId)
        {
            <div class="result-view-switch view-switch" role="group" aria-label="Представление результата">
                <button type="button" class="@(!_technicalMode ? "active" : null)" aria-pressed="@(!_technicalMode)" @onclick="() => SetMode(false)"><span aria-hidden="true">◫</span> Обычный</button>
                <button type="button" class="@(_technicalMode ? "active" : null)" aria-pressed="@_technicalMode" @onclick="() => SetMode(true)"><span aria-hidden="true">{ }</span> Технический</button>
            </div>
        }
        @if (_selected?.Id == TrueApiBulkCodeInfoHandler.OperationId && _codeResults is not null && _result.Success)
        {
            <h2>Результат запроса</h2>
            <BulkCodeSummary Counts="@TextCounts" SelectedCount="@BulkShownItems.Count"
                             CanPreview="true"
                             PreviewKey="@($"{_result.CorrelationId}:{string.Join(',', SelectedBulkStatuses.Order())}")"
                             PreviewPageLoader="@PreviewBulkTextAsync" OnDownload="@DownloadBulkTextAsync" />
        }
        else if (!_technicalMode && _selected?.Id != TrueApiBulkCodeInfoHandler.OperationId && _codeResults is not null)
        {
            <CodeInfoResultView Results="_codeResults" Busy="_running" OnCodeSelected="RequestRelatedCodeAsync" OnGtinSelected="RequestGtin" OnVsdSelected="RequestVsd" OnDocumentSelected="RequestHistoryDocument" OnPermitSelected="RequestPermit" />
        }
        else if (!_technicalMode && _aggregationTree is not null)
        {
            <AggregationTreeResultView Result="_aggregationTree" />
        }
        else if (!_technicalMode && _nationalCatalogResult is not null)
        {
            <NationalCatalogProductResultView Result="_nationalCatalogResult" />
        }
        else if (!_technicalMode && _documentStatusResults is not null)
        {
            <DocumentStatusResultView Results="_documentStatusResults" />
        }
        else if (!_technicalMode && _suzDocumentStatusResults is not null)
        {
            <SuzDocumentStatusResultView Results="_suzDocumentStatusResults" />
        }
        else if (!_technicalMode && _mercuryVsd is not null)
        {
            <MercuryVsdResultView Result="_mercuryVsd" />
        }
        else if (!_technicalMode && _permitDocument is not null)
        {
            <PermitDocumentResultView Result="_permitDocument" />
        }
        else if (!_technicalMode && _selected?.Id == TrueApiDocumentStatusHandler.OperationId && _result.Success)
        {
            <div class="notice error" role="alert">Не удалось прочитать ответ True API. Проверьте технический результат.</div>
        }
        else if (!_technicalMode && _result.Error is not null)
        {
            <div class="friendly-result-head">
                <div class="result-icon error-icon" aria-hidden="true">!</div>
                <div><span class="eyebrow">Проверьте исходные данные</span><h2>Запрос не выполнен</h2></div>
            </div>
            <div class="notice error validation-result" role="alert">@_result.Error.Message</div>
        }
        else if (!_technicalMode && _result.Success)
        {
            <div class="friendly-result-head">
                <div class="result-icon" aria-hidden="true">✓</div>
                <div><span class="eyebrow">Результат проверки</span><h2>Информация получена</h2><p class="muted">Данные подготовлены в удобном для чтения виде.</p></div>
            </div>
            <div class="result-grid">
                <IncrementalList Items="@_friendlyResult" Context="field">
                    <article class="result-field"><span>@field.Label</span><strong>@field.Value</strong></article>
                </IncrementalList>
            </div>
        }
        else
        {
            <div class="panel-title">
                <div><span class="eyebrow">Технический результат</span><h2>Фактические HTTP-обмены</h2></div>
                <div class="actions compact"><button type="button" class="button ghost" @onclick="CopyRequestAsync">Копировать запрос</button><button type="button" class="button ghost" @onclick="CopyResponseAsync">Копировать ответ</button><button type="button" class="button ghost" @onclick="ExecuteAsync" disabled="@_running">Повторить</button></div>
            </div>
            <div class="metrics"><span>Method <strong>@_result.HttpMethod</strong></span><span>Status <strong class="@(_result.Success ? "success" : "danger")">@(_result.StatusCode?.ToString() ?? "ERROR")</strong></span><span>Duration <strong>@_result.Duration.TotalMilliseconds.ToString("0") ms</strong></span></div>
            @if (_result.Error is not null)
            {
                <div class="notice error">@_result.Error.Message</div>
            }
            <IncrementalList Items="@(_result.Exchanges ?? [])" ResetKey="@_result.CorrelationId" Context="exchange">
                <details class="exchange-section" open>
                    <summary><span>@exchange.HttpMethod @exchange.RequestUrl — HTTP @exchange.StatusCode</span><span class="chevron" aria-hidden="true">⌄</span></summary>
                    <div class="exchange-content"><h3>Request</h3><pre>@exchange.RequestHeaders</pre>@if (!string.IsNullOrWhiteSpace(exchange.RequestBody)) { <pre>@exchange.RequestBody</pre> }<h3>Response</h3><pre>@exchange.ResponseHeaders</pre><pre>@exchange.ResponseBody</pre></div>
                </details>
            </IncrementalList>
        }
    </section>
}

@code {
    private sealed record MockExample(string Display, string Field, string Value);
    private static readonly IReadOnlyDictionary<string, MockExample> MockExamples = new Dictionary<string, MockExample>
    {
        [TrueApiAggregationTreeHandler.OperationId] = new("010460000000000021TREE000000001", "code", "010460000000000021TREE000000001"),
        [TrueApiCodeInfoHandler.OperationId] = new("010460000000000021DEMO000000001", "codes", "010460000000000021DEMO000000001"),
        [TrueApiBulkCodeInfoHandler.OperationId] = new("010460000000000021DEMO000000001\n010460000000000021DEMO000000002", "codes", "Два КМ с разными статусами"),
        [TrueApiDocumentStatusHandler.OperationId] = new("demo-success", "documentId", "demo-success"),
        [NationalCatalogProductHandler.OperationId] = new("04600000000000", "gtin", "04600000000000"),
        [SuzDocumentStatusHandler.OperationId] = new("00000000-0000-0000-0000-000000000001", "documentId", "00000000-0000-0000-0000-000000000001"),
        [MercuryVsdInfoHandler.OperationId] = new(MercuryVsdInfoHandler.ExampleUid, "uid", MercuryVsdInfoHandler.ExampleUid),
        [PermitDocumentLookupHandler.OperationId] = new(PermitDocumentLookupHandler.ExampleNumber, "number", PermitDocumentLookupHandler.ExampleNumber),
        ["suz.order-status"] = new("demo-order-001", "value", "demo-order-001")
    };

    private void ApplyMockExample(MockExample example) => SetValue(example.Field, example.Value);
    private void ApplyLargeBoxExample() => SetValue("codes", "000000000000000100");
    private string? TraceXImportKey => _selected is null ? null : $"tracex-{_selected.Id}";

    private static readonly (string Code, string Label)[] BulkStatuses =
    [
        ("EMITTED", "Эмитирован"), ("APPLIED", "Нанесён"), ("INTRODUCED", "В обороте"),
        ("WRITTEN_OFF", "Списан"), ("RETIRED", "Выбыл"), ("WITHDRAWN", "Выбыл (табак)"),
        ("DISAGGREGATION", "Расформирован"), ("DISAGGREGATED", "Расформирован (табак)")
    ];
    private static string BulkProductGroupName(CisInfo? info) =>
        CodeCorrectionRules.Groups.FirstOrDefault(group => group.Code == info?.ProductGroup || group.Id == info?.ProductGroupId)?.Name
        ?? info?.ProductGroup ?? "—";
    private readonly HashSet<string> _bulkStatuses = BulkStatuses.Select(x => x.Code).ToHashSet(StringComparer.Ordinal);
    private bool _bulkPaidOnly = true;
    private HashSet<string> SelectedBulkStatuses
    {
        get
        {
            var statuses = new HashSet<string>(_bulkStatuses, StringComparer.Ordinal);
            if (!_bulkPaidOnly) statuses.Add("APPLIED_NOT_PAID");
            return statuses;
        }
    }
    private IReadOnlyList<BulkCodeJob> _bulkJobs = [];
    private RecordPageCursor? _bulkJobsCursor;
    private long? _bulkJobsTotal;
    private Guid? _bulkJobsProfileId;
    private bool _bulkJobsInitialized, _bulkJobsLoading;
    private int _bulkJobsVersion;
    private readonly Dictionary<Guid, (long Completed, IReadOnlyDictionary<string, long> Counts)> _bulkStatusCounts = [];
    private Guid? _bulkCountsProfileId;
    private long SelectedBulkCount(Guid id) => _bulkStatusCounts.TryGetValue(id, out var entry)
        ? SelectedBulkStatuses.Sum(status => entry.Counts.GetValueOrDefault(status)) : 0;
    private IReadOnlyDictionary<string, long> JobCounts(Guid id) => _bulkStatusCounts.TryGetValue(id, out var entry)
        ? entry.Counts : new Dictionary<string, long>();
    private IReadOnlyDictionary<string, long> TextCounts => _codeResults?.Items
        .Where(CodeInfoResults.IsFound)
        .Where(item => !string.IsNullOrWhiteSpace(item.CisInfo?.Status))
        .GroupBy(item => item.CisInfo!.Status!, StringComparer.Ordinal)
        .ToDictionary(group => group.Key, group => (long)group.Count(), StringComparer.Ordinal)
        ?? new Dictionary<string, long>();
    private bool _bulkUploading;
    private string? _bulkFileError;
    private readonly CancellationTokenSource _bulkPollCancellation = new();
    private List<CodeInfoItem> BulkShownItems { get; set; } = [];
    private void RefreshBulkSelection()
    {
        BulkShownItems = _codeResults is null ? [] : BulkCodeInfoSelection.Filter(_codeResults, SelectedBulkStatuses).ToList();
    }
    private Task<FileRecordPage> PreviewBulkTextAsync(FilePageCursor? cursor)
    {
        var offset = (int)(cursor?.ByteOffset ?? 0);
        var items = BulkShownItems.Skip(offset).Take(100)
            .Select(item => item.CisInfo?.RequestedCis ?? item.CisInfo?.Cis ?? "").ToArray();
        var next = offset + items.Length;
        return Task.FromResult(new FileRecordPage(items, next < BulkShownItems.Count ? new FilePageCursor(0, next) : null));
    }
    private Task DownloadBulkTextAsync() => JavaScript.InvokeVoidAsync("crptWorkbench.downloadText",
        "codes.txt", BulkCodeInfoSelection.CopyCodes(BulkShownItems) + "\n").AsTask();
    private Task<FileRecordPage> PreviewBulkJobAsync(Guid id, FilePageCursor? cursor) => Workbench.ProfileId is { } profileId
        ? BulkFiles.PreviewPageAsync(profileId, id, SelectedBulkStatuses, cursor, _bulkPollCancellation.Token)
        : Task.FromResult(new FileRecordPage([], null));
    private void SetBulkStatus(string code, bool selected)
    {
        if (selected) _bulkStatuses.Add(code); else _bulkStatuses.Remove(code);
        RefreshBulkSelection();
    }
    private void SetBulkPaidOnly(bool selected)
    {
        _bulkPaidOnly = selected;
        RefreshBulkSelection();
    }
    private void CancelBulk() => _executionCancellation?.Cancel();
    private IReadOnlyList<ApiOperationDescriptor> _operations = [];
    private readonly Dictionary<string, string> _values = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<ResultField> _friendlyResult = [];
    private ApiOperationDescriptor? _selected;
    private ApiExecutionResult? _result;
    private CodeInfoResults? _codeResults;
    private AggregationTreeResult? _aggregationTree;
    private ApiOperationProgress? _treeProgress;
    private int _executionVersion;
    private bool _disposed;
    private ConsoleCodeSnapshot? _codeSnapshot;
    private string? _returnUrl;
    private sealed record ConsoleCodeSnapshot(Guid ProfileId, string Url, ApiOperationDescriptor Operation,
        Dictionary<string, string> Values, ApiExecutionResult? Result, CodeInfoResults? Codes, bool TechnicalMode);
    private NationalCatalogProductResult? _nationalCatalogResult;
    private DocumentStatusResults? _documentStatusResults;
    private SuzDocumentStatusResults? _suzDocumentStatusResults;
    private MercuryVsdInfoResult? _mercuryVsd;
    private PermitDocumentResult? _permitDocument;
    private bool _technicalMode;
    private bool _running;
    private bool _documentLookupMissing;
    private string? _documentLookupNotice;
    private CancellationTokenSource? _executionCancellation;
    private string? _validationError;
    private InputValidationResult _fieldValidation = new([]);
    private string? GetFieldHelp(string? help) => IsProduction && help is not null
        ? help.StartsWith("Mock:", StringComparison.OrdinalIgnoreCase) ? null
            : help.StartsWith("Для локальной проверки:", StringComparison.Ordinal) ? "Также поддерживается ИдФайл." : help
        : help;
    private bool IsProduction => IntegrationOptions.Value.Mode == CrptIntegrationMode.Production;
    private string ModeHeadline => IsProduction ? "Промышленный контур." : "Локальная симуляция.";
    private string ModeDescription => IsProduction
        ? "Интеграции работают с промышленным контуром."
        : "Все интеграции работают в mock-режиме. Сетевые запросы в Честный Знак не выполняются.";
    protected override async Task OnInitializedAsync()
    {
        _operations = Registry.List();
        SelectOperation(_operations.FirstOrDefault());
        var profiles = await Profiles.ListAsync();
        Workbench.ProfileId ??= profiles.FirstOrDefault()?.Id;
        await RefreshBulkJobsAsync();
        _ = PollBulkJobsAsync();
        Workbench.ProfileChanged += OnProfileChanged;
    }


    private bool _unknownOperation;
    private string? _lastQuery;
    [SupplyParameterFromQuery(Name = "operation")] public string? RequestedOperation { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? RequestedCode { get; set; }
    [SupplyParameterFromQuery(Name = "document")] public string? RequestedDocument { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string? RequestedSource { get; set; }
    [SupplyParameterFromQuery(Name = "productGroup")] public string? RequestedProductGroup { get; set; }
    [SupplyParameterFromQuery(Name = "gtin")] public string? RequestedGtin { get; set; }
    [SupplyParameterFromQuery(Name = "vsd")] public string? RequestedVsd { get; set; }
    [SupplyParameterFromQuery(Name = "permit")] public string? RequestedPermit { get; set; }
    [SupplyParameterFromQuery(Name = "returnTo")] public string? RequestedReturnTo { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        if (query == _lastQuery) return;
        _lastQuery = query;
        if (_codeSnapshot is { } snapshot && Workbench.ProfileId == snapshot.ProfileId &&
            Navigation.Uri == snapshot.Url)
        {
            _selected = snapshot.Operation;
            _values.Clear();
            foreach (var value in snapshot.Values) _values[value.Key] = value.Value;
            _result = snapshot.Result;
            _codeResults = snapshot.Codes;
            _technicalMode = snapshot.TechnicalMode;
            _nationalCatalogResult = null;
            _documentStatusResults = null;
            _suzDocumentStatusResults = null;
            _mercuryVsd = null;
            _permitDocument = null;
            _documentLookupNotice = null;
            _returnUrl = null;
            return;
        }
        _returnUrl = ValidReturnUrl(RequestedReturnTo);
        if (!string.IsNullOrWhiteSpace(RequestedPermit))
        {
            SelectOperation(_operations.FirstOrDefault(x => x.Id == PermitDocumentLookupHandler.OperationId));
            _values["number"] = RequestedPermit;
            _technicalMode = false;
            await ExecuteAsync();
            return;
        }
        if (!string.IsNullOrWhiteSpace(RequestedVsd))
        {
            SelectOperation(_operations.FirstOrDefault(x => x.Id == MercuryVsdInfoHandler.OperationId));
            _values["uid"] = RequestedVsd;
            _technicalMode = false;
            await ExecuteAsync();
            return;
        }
        if (!string.IsNullOrWhiteSpace(RequestedGtin))
        {
            SelectOperation(_operations.FirstOrDefault(x => x.Id == NationalCatalogProductHandler.OperationId));
            _values["gtin"] = RequestedGtin;
            _technicalMode = false;
            await ExecuteAsync();
            return;
        }
        if (!string.IsNullOrWhiteSpace(RequestedDocument))
        {
            await RequestHistoryDocumentAsync(new(RequestedDocument,
                RequestedSource == "suz" ? ApiSystem.Suz : ApiSystem.TrueApi, RequestedProductGroup));
            return;
        }
        var destination = OperationNavigation.ResolveConsole(query, _operations);
        if (destination.Code is not null)
            await RequestRelatedCodeAsync(destination.Code);
        else if (destination.Operation is { } operation)
        {
            SelectOperation(operation);
        }
        else if (destination.UnknownOperation)
        {
            SelectOperation(null);
            _unknownOperation = true;
        }
        else if (_unknownOperation)
            SelectOperation(_operations.FirstOrDefault());
    }

    private void SelectOperation(ApiOperationDescriptor? operation)
    {
        _unknownOperation = false;
        _documentLookupNotice = null;
        _documentLookupMissing = false;
        _selected = operation;
        _aggregationTree = null;
        _treeProgress = null;
        _result = null;
        _codeResults = null;
        RefreshBulkSelection();
        _nationalCatalogResult = null;
        _documentStatusResults = null;
        _suzDocumentStatusResults = null;
        _mercuryVsd = null;
        _permitDocument = null;
        _friendlyResult = [];
        _validationError = null;
        _fieldValidation = new([]);
        _values.Clear();
        if (operation is null) return;
        foreach (var field in operation.Fields) _values[field.Name] = string.Empty;
    }

