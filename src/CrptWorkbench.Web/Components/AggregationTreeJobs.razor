@implements IAsyncDisposable
@inject AggregationTreeJobService Jobs
@inject AggregationTreeDownloadTickets Tickets
@inject WorkbenchContext Workbench
@inject IJSRuntime JavaScript
@inject NavigationManager Navigation

<div class="aggregation-jobs">
    <FileTextInput ZoneId="aggregation-source-drop" FileId="aggregation-source-file" Disabled="@_busy" Hint="TXT UTF-8, один код на строку. Файл сохраняется как фоновое задание." OnFileChange="UploadAsync">
        <label for="aggregation-source-text">Коды маркировки</label>
        <textarea id="aggregation-source-text" rows="7" disabled="@_busy" spellcheck="false" placeholder="Один код на строку"></textarea>
    </FileTextInput>
    <div class="actions"><button class="button primary" disabled="@_busy" @onclick="PrepareTextAsync">@(_busy ? "Подготовка…" : "Подготовить список")</button>
        <TraceXSqlImport Bulk="true" Disabled="@_busy" OnPreparedSource="PrepareTraceXAsync" />
    </div>
    <label class="checkbox-field"><input type="checkbox" @bind="_siblings" disabled="@_busy" /><span>Загружать соседние ветви</span></label>
    <p class="muted">Подготовьте источник, затем запустите задание. После паузы или перезапуска продолжение выполняется вручную.</p>
    @if (_error is not null) { <p class="error-text" role="alert">@_error</p> }
    <div class="actions"><h3>Сохранённые задания</h3><button class="button ghost" disabled="@_busy" @onclick="RefreshTreeAsync">Обновить</button></div>
    @foreach (var job in _jobs)
    {
        <article @key="job.Id" class="panel aggregation-job">
            <h3>@job.Name</h3><p role="status">@StateLabel(job.State) · загружено @job.NodesLoaded из @job.NodesTotal узлов · ошибок @job.NodeErrors</p>
            <progress value="@job.SourceOffset" max="@Math.Max(1, job.SourceBytes)"></progress>
            <small class="muted">Прочитано строк: @job.LinesRead. Отклонено: @job.RejectedRows.</small>
            @if (job.Error is not null) { <p class="error-text">@job.Error</p> }
            <div class="actions">
                @if (job.State == "Ready") { <button class="button primary" disabled="@_busy" @onclick="() => StartAsync(job)">Запустить</button> }
                @if (job.State is "Queued" or "Running") { <button class="button ghost" disabled="@_busy" @onclick="() => ActAsync(() => Jobs.PauseAsync(job.ProfileId, job.Id, _lifetime.Token))">Пауза</button> }
                @if (job.State == "Paused") { <button class="button primary" disabled="@_busy" @onclick="() => ActAsync(() => Jobs.ResumeAsync(job.ProfileId, job.Id, _lifetime.Token))">Продолжить</button> }
                @if (job.State is "Queued" or "Running" or "Paused" or "PauseRequested") { <button class="button ghost" disabled="@_busy" @onclick="() => ActAsync(() => Jobs.CancelAsync(job.ProfileId, job.Id, _lifetime.Token))">Отменить</button> }
                <button class="button ghost" disabled="@_busy" @onclick="() => OpenAsync(job)">@(_opened?.Id == job.Id ? "Скрыть дерево" : "Открыть дерево")</button>
                @if (job.State is "Ready" or "Paused" or "Completed" or "Partial" or "Canceled" or "Failed" or "Deleting") { <button class="button ghost" disabled="@_busy" @onclick="() => DeleteAsync(job)">@(job.State == "Deleting" ? "Повторить удаление" : "Удалить")</button> }
            </div>
            @if (_opened?.Id == job.Id)
            {
                @if (CanExport(job.State))
                {
                    <fieldset class="aggregation-export"><legend>Скачать агрегацию TXT</legend>
                        <div class="aggregation-export-options">
                            <label class="aggregation-export-option"><input type="radio" name="aggregation-export" checked="@_fullTree" @onchange="() => _fullTree = true" /><span>Полное дерево</span></label>
                            <label class="aggregation-export-option"><input type="radio" name="aggregation-export" checked="@(!_fullTree)" @onchange="() => _fullTree = false" /><span>Выбранные типы упаковки</span></label>
                        </div>
                        @if (!_fullTree)
                        {
                            <div class="aggregation-types">@foreach (var type in _types) { <label><input type="checkbox" checked="@_selectedTypes.Contains(type)" @onchange="args => SelectType(type, args.Value is true)" /><span>@TypeLabel(type)</span></label> }</div>
                        }
                        <div class="aggregation-export-footer">
                            @if (!_fullTree && _selectedTypes.Count == 0) { <p class="muted">Выберите хотя бы один тип.</p> }
                            <button class="button primary" disabled="@(_busy || !_fullTree && _selectedTypes.Count == 0)" @onclick="() => ExportAsync(job)">Скачать TXT</button>
                        </div>
                    </fieldset>
                }
                @if (job.RejectedRows > 0)
                {
                    <details><summary>Отклонённые строки (@job.RejectedRows)</summary>
                        @if (_rejectedHasMore) { <button class="button ghost" disabled="@_busy" @onclick="() => LoadRejectedAsync(job)">Добавить 100 строк</button> }
                        <a class="button ghost" href="@RejectedUrl(job)" download>Скачать отчёт</a>
                        <ol>@foreach (var row in _rejected) { <li value="@row.Line"><code>@row.Value</code> — @row.Reason</li> }</ol>
                    </details>
                }
                <div role="tree" aria-label="Дерево агрегации"><AggregationTreeJobBranch @key="_treeKey" ProfileId="job.ProfileId" JobId="job.Id" /></div>
            }
        </article>
    }
    @if (_hasMore) { <button class="button ghost" disabled="@_busy" @onclick="LoadMoreAsync">Добавить ещё 100 заданий</button> }
</div>

@code {
    [Parameter] public Guid? OpenJobId { get; set; }
    [Parameter] public string? InitialText { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource _profileCancellation = new();
    private readonly List<AggregationTreeJob> _jobs = [];
    private readonly List<AggregationRejectedRow> _rejected = [];
    private readonly HashSet<string> _selectedTypes = new(StringComparer.Ordinal);
    private IReadOnlyList<string> _types = [];
    private AggregationTreeJob? _opened;
    private IJSObjectReference? _module;
    private bool _busy, _siblings, _fullTree = true, _hasMore, _rejectedHasMore = true;
    private string? _error;
    private long? _rejectedCursor;
    private long? _pageCursor;
    private string _treeKey = "";
    private Task? _poll;
    private Guid? _requestedJob;
    private int _profileVersion;
    protected override async Task OnInitializedAsync()
    {
        Workbench.ProfileChanged += ProfileChanged;
        await RefreshSafeAsync(); _poll = PollAsync();
    }
    protected override async Task OnParametersSetAsync()
    {
        if (OpenJobId is { } id && id != _requestedJob && Workbench.ProfileId is { } profile)
        {
            _requestedJob = id;
            try
            {
                var job = await Jobs.GetAsync(profile, id, _lifetime.Token);
                if (Workbench.ProfileId != profile) return;
                if (job is null) _error = "Задание не найдено в выбранном профиле или удалено.";
                else
                {
                    if (_jobs.All(j => j.Id != id)) _jobs.Add(job);
                    await OpenAsync(job);
                }
            }
            catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
            catch (Exception) { if (Workbench.ProfileId == profile) _error = "Не удалось открыть сохранённое задание."; }
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./js/package-drop.js");
        if (!string.IsNullOrEmpty(InitialText)) await _module.InvokeVoidAsync("setText", "aggregation-source-text", InitialText);
    }
    private void ProfileChanged(object? sender, Guid? id) => _ = InvokeAsync(async () =>
    {
        _profileVersion++; _profileCancellation.Cancel(); _profileCancellation.Dispose(); _profileCancellation = new();
        _busy = false; _opened = null; _types = []; _rejected.Clear(); _jobs.Clear(); _pageCursor = null; _requestedJob = null; _error = null;
        if (_module is not null) await _module.InvokeVoidAsync("setText", "aggregation-source-text", "");
        await RefreshSafeAsync(); StateHasChanged();
    });
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try { while (await timer.WaitForNextTickAsync(_lifetime.Token)) await InvokeAsync(async () => { if (!_busy) { try { await RefreshLoadedAsync(); } catch (Exception) { if (!_lifetime.IsCancellationRequested) _error = "Не удалось обновить задания."; } StateHasChanged(); } }); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }
    private Task RefreshLoadedAsync() => RefreshJobsAsync(activeOnly: true);
    private async Task RefreshJobsAsync(bool activeOnly)
    {
        var profile = Workbench.ProfileId;
        if (profile is null) return;
        var version = _profileVersion;
        var ids = _jobs.Where(job => !activeOnly || job.State is "Queued" or "Running" or "PauseRequested" or "CancelRequested" or "Deleting")
            .Select(job => job.Id).ToArray();
        if (ids.Length == 0) return;
        var refreshed = (await Jobs.GetManyAsync(profile.Value, ids, _lifetime.Token)).ToDictionary(job => job.Id);
        if (Workbench.ProfileId != profile || version != _profileVersion) return;
        var requested = ids.ToHashSet();
        for (var i = _jobs.Count - 1; i >= 0; i--)
        {
            if (!requested.Contains(_jobs[i].Id)) continue;
            if (refreshed.TryGetValue(_jobs[i].Id, out var updated)) _jobs[i] = updated;
            else _jobs.RemoveAt(i);
        }
    }
    private async Task RefreshSafeAsync()
    {
        try { await RefreshAsync(); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { _error = "Не удалось прочитать задания. Повторите обновление."; }
    }
    private async Task RefreshTreeAsync()
    {
        await RefreshSafeAsync();
        if (_opened is { } job && Workbench.ProfileId == job.ProfileId)
        {
            _treeKey = $"{job.Id}:{Guid.NewGuid()}";
            try { _types = await Jobs.TypesAsync(job.ProfileId, job.Id, _lifetime.Token); }
            catch (Exception) { _error = "Не удалось обновить типы упаковки."; }
        }
    }
    private async Task RefreshAsync()
    {
        if (Workbench.ProfileId is not { } profile) return;
        var page = await Jobs.ListAsync(profile, cancellationToken: _lifetime.Token);
        if (Workbench.ProfileId != profile) return;
        if (_pageCursor is null)
        {
            _hasMore = page.Count == 100;
            _pageCursor = page.LastOrDefault()?.CreatedAt.ToUnixTimeMilliseconds();
        }
        var old = _jobs.Where(j => page.All(current => current.Id != j.Id)).ToArray();
        _jobs.Clear(); _jobs.AddRange(page); _jobs.AddRange(old);
        await RefreshJobsAsync(activeOnly: false);

    }
    private async Task LoadMoreAsync() => await ActAsync(LoadMorePageAsync);
    private async Task LoadMorePageAsync()
    {
        if (Workbench.ProfileId is not { } profile || _pageCursor is null) return;
        var page = await Jobs.ListAsync(profile, _pageCursor, _lifetime.Token);
        if (Workbench.ProfileId != profile) return;
        _jobs.AddRange(page.Where(j => _jobs.All(old => old.Id != j.Id))); _hasMore = page.Count == 100;
        if (page.Count > 0) _pageCursor = page[^1].CreatedAt.ToUnixTimeMilliseconds();
    }
    private async Task PrepareTextAsync() => await ActAsync(async () =>
    {
        if (_module is null || Workbench.ProfileId is not { } profile) return;
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token, _profileCancellation.Token);
        var token = cancellation.Token;
        await using var reference = await _module.InvokeAsync<IJSStreamReference>("readText", token, "aggregation-source-text");
        await using var source = await reference.OpenReadStreamAsync(long.MaxValue, token);
        await Jobs.PrepareAsync(profile, "Вставленный список", source, token);
    });
    private async Task UploadAsync(InputFileChangeEventArgs args) => await ActAsync(async () =>
    {
        if (Workbench.ProfileId is not { } profile) return;
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token, _profileCancellation.Token);
        var token = cancellation.Token;
        await using var source = args.File.OpenReadStream(long.MaxValue, token);
        await Jobs.PrepareAsync(profile, args.File.Name, source, token);
    });
    private async Task PrepareTraceXAsync((Guid ProfileId, long Bytes, Stream Source) source)
    {
        if (_busy || Workbench.ProfileId != source.ProfileId) throw new InvalidOperationException("Выберите исходный профиль и повторите подготовку.");
        _busy = true; _error = null;
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token, _profileCancellation.Token);
        try { await Jobs.PrepareAsync(source.ProfileId, "TraceX", source.Source, cancellation.Token); await RefreshAsync(); }
        finally { _busy = false; }
    }
    private async Task StartAsync(AggregationTreeJob job) => await ActAsync(async () => { await Jobs.StartAsync(job.ProfileId, job.Id, _siblings, _lifetime.Token); });
    private async Task DeleteAsync(AggregationTreeJob job) => await ActAsync(async () => { await Jobs.DeleteAsync(job.ProfileId, job.Id, _lifetime.Token); if (_opened?.Id == job.Id) _opened = null; });
    private async Task OpenAsync(AggregationTreeJob job)
    {
        if (_opened?.Id == job.Id) { _opened = null; return; }
        var version = _profileVersion;
        try
        {
            var types = await Jobs.TypesAsync(job.ProfileId, job.Id, _lifetime.Token);
            var rejected = job.RejectedRows > 0 ? await Jobs.RejectedAsync(job.ProfileId, job.Id, null, _lifetime.Token) : null;
            if (version != _profileVersion || Workbench.ProfileId != job.ProfileId) return;
            _opened = job; _treeKey = $"{job.Id}:{Guid.NewGuid()}";
            _types = types; _selectedTypes.Clear(); _rejected.Clear();
            if (rejected is not null) _rejected.AddRange(rejected.Items);
            _rejectedCursor = rejected?.NextCursor; _rejectedHasMore = rejected?.NextCursor is not null;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception) { if (version == _profileVersion) _error = "Не удалось открыть дерево. Повторите действие."; }
    }
    private async Task LoadRejectedAsync(AggregationTreeJob job) => await ActAsync(async () =>
    {
        var page = await Jobs.RejectedAsync(job.ProfileId, job.Id, _rejectedCursor, _lifetime.Token);
        if (Workbench.ProfileId != job.ProfileId) return;
        _rejected.AddRange(page.Items); _rejectedCursor = page.NextCursor; _rejectedHasMore = page.NextCursor is not null;
    });
    private async Task ExportAsync(AggregationTreeJob job) => await ActAsync(async () =>
    {
        var export = await Jobs.ExportAsync(job.ProfileId, job.Id, new(_fullTree, _selectedTypes.ToArray()), _lifetime.Token);
        if (Workbench.ProfileId != job.ProfileId) return;
        if (export.Lines == 0) { _error = "Подтверждённых путей для выбранных типов нет."; return; }
        Navigation.NavigateTo("/aggregation-tree-download?ticket=" + Uri.EscapeDataString(Tickets.Issue(job.ProfileId, job.Id, job.Mode, export.Id)), forceLoad: true);
    });
    private string RejectedUrl(AggregationTreeJob job) => "/aggregation-tree-rejected-download?ticket=" + Uri.EscapeDataString(Tickets.IssueRejected(job.ProfileId, job.Id, job.Mode));
    private void SelectType(string type, bool selected) { if (selected) _selectedTypes.Add(type); else _selectedTypes.Remove(type); }
    private async Task ActAsync(Func<Task> action)
    {
        if (_busy) return; var version = _profileVersion; _busy = true; _error = null;
        try { await action(); if (version == _profileVersion) await RefreshAsync(); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (ArgumentException exception) { if (version == _profileVersion) _error = exception.Message; }
        catch (InvalidOperationException exception) { if (version == _profileVersion) _error = exception.Message; }
        catch (Exception) { if (version == _profileVersion) _error = "Не удалось выполнить действие. Проверьте свободное место и повторите."; }
        finally { if (version == _profileVersion) _busy = false; }
    }
    public static bool CanExport(string state) => state is "Paused" or "Completed" or "Partial" or "Canceled";
    public static string TypeLabel(string? type) => type switch { "UNIT" => "Единица товара", "GROUP" => "Групповая упаковка", "SET" => "Набор", "BUNDLE" => "Комплект", "BOX" => "Транспортная упаковка", "ATK" => "АТК", null or "" => "Тип неизвестен", _ => type };
    private static string StateLabel(string state) => state switch { "Ready" => "Готово к запуску", "Queued" => "В очереди", "Running" => "Загружается", "PauseRequested" => "Останавливается", "Paused" => "На паузе", "Completed" => "Завершено", "Partial" => "Частичный результат", "Canceled" => "Отменено", "CancelRequested" => "Отменяется", "Failed" => "Ошибка", _ => state };
    public async ValueTask DisposeAsync()
    {
        Workbench.ProfileChanged -= ProfileChanged; await _lifetime.CancelAsync(); await _profileCancellation.CancelAsync();
        if (_poll is not null) await _poll;
        if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
        _lifetime.Dispose(); _profileCancellation.Dispose();
    }
}
